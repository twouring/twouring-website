---
import { getLang, localizePath, switchLocaleHref, isActivePath, LOCALES, LOCALE_META } from '../i18n/utils';
import { useUI, ROUTES, SERVICE_GROUPS } from '../i18n/ui';
import { company } from '../i18n/company';
import { insights } from '../data/insights';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const pathname = Astro.url.pathname;
const lp = (p: string) => localizePath(p, lang);
const active = (p: string) => isActivePath(pathname, p);
// 只有中文版的洞察文章：切語言時回該語言的洞察列表
const artSlug = pathname.match(/\/insights\/([^/]+)\/?$/)?.[1];
const langHref = (l: typeof lang) => (artSlug && insights[artSlug] && !insights[artSlug][l] ? localizePath(ROUTES.insights, l) : switchLocaleHref(pathname, l));
const otherLangs = LOCALES.filter((l) => l !== lang).map((l) => ({
  code: l,
  href: langHref(l),
  label: LOCALE_META[l].label,
  html: LOCALE_META[l].html,
}));
const [enterpriseGroup, ...contextGroups] = SERVICE_GROUPS;
const serviceGroups = {
  zh: { enterprise: '企業解決方案', government: '政府與城市', place: '場域與國際' },
  en: { enterprise: 'Enterprise solutions', government: 'Government & cities', place: 'Venues & international' },
  ja: { enterprise: '企業向けソリューション', government: '自治体・地域', place: '拠点・国際交流' },
}[lang];
const resourceLabels = {
  zh: { pricing: '遊遊愛馬仕方案與價格', webinar: '線上說明會' },
  en: { pricing: 'Twouring Hermes pricing', webinar: 'Online briefings' },
  ja: { pricing: 'Twouring Hermesの料金', webinar: 'オンライン説明会' },
}[lang];
const a11y = {
  zh: { home: '首頁', primary: '主要導覽', mobile: '行動導覽', lang: '切換語言' },
  en: { home: 'home', primary: 'Primary', mobile: 'Mobile', lang: 'Change language' },
  ja: { home: 'ホーム', primary: 'メインナビゲーション', mobile: 'モバイルナビゲーション', lang: '言語を切り替える' },
}[lang];
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href={lp(ROUTES.home)} aria-label={`${company.brand} ${a11y.home}`}>
      <img src="/brand/twouring-wordmark.svg" alt={company.brand} width="148" height="32" />
    </a>

    <nav class="nav-desktop" aria-label={a11y.primary}>
      <ul class="nav-list">
        <li class="has-menu">
          <a
            href={lp(ROUTES.services)}
            class:list={['nav-link', { 'is-active': active(ROUTES.services) }]}
            aria-current={active(ROUTES.services) ? 'page' : undefined}
            aria-haspopup="true"
          >
            {t.nav.services}
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="mega">
            <div class="mega-group mega-group--enterprise">
              <p class="mega-group-label">{serviceGroups[enterpriseGroup.id]}</p>
              <div class="mega-enterprise-items">
                {enterpriseGroup.keys.map((key) => (
                  <a class="mega-item" href={lp(ROUTES[key])}>
                    <span class="mega-title">{t.serviceNav[key]}</span>
                    <span class="mega-desc">{t.serviceNavDesc[key]}</span>
                  </a>
                ))}
              </div>
            </div>
            <div class="mega-aside">
              {contextGroups.map((group) => (
                <div class="mega-group">
                  <p class="mega-group-label">{serviceGroups[group.id]}</p>
                  {group.keys.map((key) => (
                    <a class="mega-item" href={lp(ROUTES[key])}>
                      <span class="mega-title">{t.serviceNav[key]}</span>
                      <span class="mega-desc">{t.serviceNavDesc[key]}</span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
            <a class="mega-all" href={lp(ROUTES.services)}>{t.nav.servicesOverview} →</a>
          </div>
        </li>
        <li><a href={lp(ROUTES.cases)} class:list={['nav-link', { 'is-active': active(ROUTES.cases) }]} aria-current={active(ROUTES.cases) ? 'page' : undefined}>{t.nav.cases}</a></li>
        <li class="has-menu">
          <a href={lp(ROUTES.insights)} class:list={['nav-link', { 'is-active': active(ROUTES.insights) || active(ROUTES.pricing) || active(ROUTES.webinar) }]} aria-current={active(ROUTES.insights) || active(ROUTES.pricing) || active(ROUTES.webinar) ? 'page' : undefined} aria-haspopup="true">
            {t.nav.resources}
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="mega mega--small">
            <a class="mega-item" href={lp(ROUTES.insights)}><span class="mega-title">{t.nav.insights}</span></a>
            {lang === 'zh' && <a class="mega-item" href={lp(ROUTES.pricing)} data-cta="nav_hermes_pricing"><span class="mega-title">{resourceLabels.pricing}</span></a>}
            {lang === 'zh' && <a class="mega-item" href={lp(ROUTES.webinar)} data-cta="nav_webinar"><span class="mega-title">{resourceLabels.webinar}</span></a>}
          </div>
        </li>
        <li class="has-menu">
          <a
            href={lp(ROUTES.about)}
            class:list={['nav-link', { 'is-active': active(ROUTES.about) || active(ROUTES.careers) }]}
            aria-current={active(ROUTES.about) || active(ROUTES.careers) ? 'page' : undefined}
            aria-haspopup="true"
          >
            {t.nav.company}
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="mega mega--small">
            <a class="mega-item" href={lp(ROUTES.about)}><span class="mega-title">{t.nav.about}</span></a>
            <a class="mega-item" href={lp(ROUTES.careers)}><span class="mega-title">{t.nav.careers}</span></a>
          </div>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <details class="lang-menu">
        <summary aria-label={a11y.lang}><span aria-hidden="true">◎</span><span>{LOCALE_META[lang].label}</span></summary>
        <div class="lang-popover">
          {otherLangs.map((o) => (
            <a href={o.href} hreflang={o.html} lang={o.html} rel="alternate">{o.label}</a>
          ))}
        </div>
      </details>
      <a class="btn btn--primary btn-cta-desktop" href={company.bookingUrl} target="_blank" rel="noopener">{t.cta.primaryShort}</a>
      <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.nav.menu}>
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label={a11y.mobile}>
      <p class="m-group-label">{t.nav.services}</p>
      <ul class="m-services">
        {SERVICE_GROUPS.map((group) => (
          <>
            <li class="m-service-group">{serviceGroups[group.id]}</li>
            {group.keys.map((key) => (
              <li><a href={lp(ROUTES[key])}><strong>{t.serviceNav[key]}</strong><span>{t.serviceNavDesc[key]}</span></a></li>
            ))}
          </>
        ))}
        <li><a href={lp(ROUTES.services)} class="m-all">{t.nav.servicesOverview} →</a></li>
      </ul>
      <ul class="m-links">
        <li><a href={lp(ROUTES.cases)} aria-current={active(ROUTES.cases) ? 'page' : undefined}>{t.nav.cases}</a></li>
        <li class="m-link-group">{t.nav.resources}</li>
        <li><a href={lp(ROUTES.insights)} aria-current={active(ROUTES.insights) ? 'page' : undefined}>{t.nav.insights}</a></li>
        {lang === 'zh' && <li><a href={lp(ROUTES.pricing)} aria-current={active(ROUTES.pricing) ? 'page' : undefined} data-cta="nav_hermes_pricing_m">{resourceLabels.pricing}</a></li>}
        {lang === 'zh' && <li><a href={lp(ROUTES.webinar)} aria-current={active(ROUTES.webinar) ? 'page' : undefined} data-cta="nav_webinar_m">{resourceLabels.webinar}</a></li>}
        <li class="m-link-group">{t.nav.company}</li>
        <li><a href={lp(ROUTES.about)} aria-current={active(ROUTES.about) ? 'page' : undefined}>{t.nav.about}</a></li>
        <li><a href={lp(ROUTES.careers)} aria-current={active(ROUTES.careers) ? 'page' : undefined}>{t.nav.careers}</a></li>
        <li><a href={lp(ROUTES.contact)} aria-current={active(ROUTES.contact) ? 'page' : undefined}>{t.nav.contact}</a></li>
        {otherLangs.map((o) => (
          <li><a href={o.href} hreflang={o.html} lang={o.html}>{o.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary btn--block" href={company.bookingUrl} target="_blank" rel="noopener">{t.cta.primary}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .site-header.scrolled { border-bottom-color: var(--c-line); box-shadow: var(--shadow-sm); }
  .header-inner { display: flex; align-items: center; gap: 1rem; min-height: 68px; }
  .brand { display: inline-flex; align-items: center; flex-shrink: 0; }
  .brand img { height: 30px; width: auto; }

  .nav-desktop { margin-left: auto; }
  .nav-list { display: flex; align-items: center; gap: 0.4rem; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 0.25em;
    font-family: var(--font-head); font-weight: 700; font-size: 0.97rem;
    color: var(--c-ink-strong); padding: 0.5em 0.85em; border-radius: var(--radius-pill);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-link:hover { color: var(--c-accent-strong); background: var(--c-surface-warm); }
  .nav-link.is-active { color: var(--c-accent-strong); }
  .caret { transition: transform 0.2s ease; opacity: 0.7; }

  .has-menu { position: relative; }
  /* 填補觸發項與下拉面板的視覺間距，避免游標下移時失去 hover。 */
  .has-menu::after { content: ''; position: absolute; z-index: 1; top: 100%; left: 0; width: 100%; height: 12px; }
  .mega {
    position: absolute; top: calc(100% + 12px); left: 50%; transform: translateX(-50%) translateY(6px);
    width: min(860px, calc(100vw - 2rem)); background: #fff; border: 1px solid var(--c-line);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: 1rem; z-index: 2; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(235px, 1fr); gap: 1rem; opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .has-menu:hover .mega, .has-menu:focus-within .mega {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
  }
  .has-menu:hover .caret, .has-menu:focus-within .caret { transform: rotate(180deg); }
  .mega-group { display: grid; align-content: start; gap: 0.15rem; }
  .mega-enterprise-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.15rem 0.5rem; }
  .mega-aside { display: grid; align-content: start; gap: 0.8rem; padding-left: 1rem; border-left: 1px solid var(--c-line); }
  .mega-aside .mega-group + .mega-group { border-top: 1px solid var(--c-line); margin: 0; padding: 0.8rem 0 0; }
  .mega-group-label, .m-service-group, .m-link-group { font-size: 0.76rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-muted); font-weight: 800; }
  .mega-group-label { padding: 0.15rem 0.7rem 0.45rem; }
  .mega--small { width: min(260px, calc(100vw - 2rem)); grid-template-columns: 1fr; gap: 0.15rem; padding: 0.6rem; }
  .mega--small .mega-item { padding: 0.75em 0.9em; }
  .mega-item { display: grid; gap: 0.16rem; padding: 0.7em; border-radius: var(--radius); color: var(--c-ink-strong); }
  .mega-item:hover { background: var(--c-surface-warm); }
  .mega-title { font-family: var(--font-head); font-weight: 700; }
  .mega-desc { font-size: 0.85rem; color: var(--c-muted); }
  .mega-all { grid-column: 1 / -1; padding: 0.75em 0.7em 0 0.7em; font-weight: 700; font-family: var(--font-head); color: var(--c-accent-strong); border-top: 1px solid var(--c-line); margin-top: 0.1rem; }
  .mega--small .mega-all { grid-column: auto; }

  .header-actions { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
  .lang-menu { position: relative; }
  .lang-menu summary { list-style: none; display: inline-flex; align-items: center; gap: 0.38rem; padding: 0.65em 0.7em; border-radius: var(--radius); color: var(--c-ink-strong); cursor: pointer; font-family: var(--font-head); font-weight: 700; font-size: 0.9rem; }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-menu summary:hover, .lang-menu[open] summary { color: var(--c-accent-strong); background: var(--c-surface-warm); }
  .lang-popover { position: absolute; right: 0; top: calc(100% + 0.55rem); min-width: 8rem; display: grid; padding: 0.4rem; border: 1px solid var(--c-line); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow-lg); }
  .lang-popover a { padding: 0.55em 0.65em; border-radius: calc(var(--radius) - 2px); color: var(--c-ink-strong); font-family: var(--font-head); font-weight: 700; }
  .lang-popover a:hover { background: var(--c-surface-warm); color: var(--c-accent-strong); }
  @media (max-width: 1100px) {
    .nav-desktop, .btn-cta-desktop { display: none; }
    .header-actions { margin-left: auto; }
    .menu-toggle { display: grid; }
  }
  @media (max-width: 520px) {
    .lang-menu summary span:last-child { display: none; }
  }
  .menu-toggle { display: none; width: 42px; height: 42px; border: 1.5px solid var(--c-line-strong); background: #fff; border-radius: var(--radius); cursor: pointer; place-items: center; }
  .menu-bars { display: grid; gap: 4px; width: 18px; }
  .menu-bars span { height: 2px; background: var(--c-ink-strong); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu { border-top: 1px solid var(--c-line); background: #fff; padding-block: 1.2rem 1.6rem; max-height: calc(100dvh - 68px); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .mobile-menu[hidden] { display: none; }
  .m-group-label { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-faint); font-weight: 700; margin-bottom: 0.4rem; }
  .m-services { display: grid; gap: 0.2rem; padding-bottom: 0.8rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--c-line); }
  .m-services a { display: grid; gap: 0.1rem; padding: 0.6em 0.7em; border-radius: var(--radius); color: var(--c-ink-strong); }
  .m-services a:hover { background: var(--c-surface-warm); }
  .m-services span { font-size: 0.85rem; color: var(--c-muted); }
  .m-service-group { padding: 0.75rem 0.7rem 0.2rem; }
  .m-service-group + li a { margin-top: 0.1rem; }
  .m-all { color: var(--c-accent-strong) !important; font-weight: 700; }
  .m-links { display: grid; gap: 0.1rem; margin-bottom: 1rem; }
  .m-link-group { padding: 1rem 0.7rem 0.2rem; margin-top: 0.3rem; border-top: 1px solid var(--c-line); }
  .m-links a { display: block; padding: 0.7em 0.7em; border-radius: var(--radius); font-family: var(--font-head); font-weight: 700; color: var(--c-ink-strong); }
  .m-links a:hover { background: var(--c-surface-warm); }

  @media (max-width: 1100px) {
    .nav-desktop, .btn-cta-desktop { display: none; }
    .nav-desktop { margin-left: 0; }
    .header-actions { margin-left: auto; }
    .menu-toggle { display: grid; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const closeMenu = (returnFocus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
      document.body.style.overflow = '';
      if (returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      if (open) return closeMenu();
      toggle.setAttribute('aria-expanded', 'true');
      menu.hidden = false;
      document.body.style.overflow = 'hidden';
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeMenu()));
    // Esc 關閉行動選單並把焦點還給切換鈕
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') closeMenu(true);
    });
  }

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
