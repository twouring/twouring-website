---
import { getLang, localizePath } from '../i18n/utils';
import { useUI, ROUTES } from '../i18n/ui';

interface Crumb { label: string; path?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  /** 選用：已斷好詞組的標題 HTML（只放自家資料，不放使用者輸入） */
  titleHtml?: string;
  lead?: string;
  crumbs?: Crumb[];
  variant?: 'default' | 'warm';
  /** 選用：右側示意圖（public 路徑）與替代文字 */
  image?: { src: string; alt: string; credit?: string };
}
const { eyebrow, title, titleHtml, lead, crumbs = [], variant = 'warm', image } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);
const home = { zh: '首頁', en: 'Home', ja: 'ホーム' }[lang];
---
<section class:list={['page-hero', `page-hero--${variant}`]}>
  <div class:list={['container', { 'hero-split': image }]}>
    <div class="hero-copy">
    <nav class="crumbs" aria-label={{ zh: '麵包屑', en: 'Breadcrumb', ja: 'パンくずリスト' }[lang]}>
      <a href={lp(ROUTES.home)}>{home}</a>
      {crumbs.map((c) => (
        <>
          <span class="sep" aria-hidden="true">/</span>
          {c.path ? <a href={lp(c.path)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </>
      ))}
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {titleHtml ? <h1 set:html={titleHtml} /> : <h1>{title}</h1>}
    {lead && <p class="lead hero-lead">{lead}</p>}
    <slot />
    </div>
    {image && (
      <figure class="hero-fig">
        <img src={image.src} alt={image.alt} width="1200" height="800" fetchpriority="high" />
        {image.credit && <figcaption>{image.credit}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(2.4rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem); position: relative; overflow: hidden; }
  .page-hero--warm { background: var(--grad-soft); border-bottom: 1px solid var(--c-line); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; font-size: 0.88rem; color: var(--c-muted); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--c-muted); }
  .crumbs a:hover { color: var(--c-accent-strong); }
  .crumbs .sep { color: var(--c-faint); }
  .page-hero h1 { max-width: 18ch; }
  .hero-lead { margin-top: 1rem; max-width: 60ch; }
  .eyebrow { margin-bottom: 0.8rem; }
  .hero-split { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: stretch; }
  .hero-fig { display: flex; flex-direction: column; }
  .hero-split h1 { max-width: none; font-size: clamp(1.9rem, 2.9vw, 2.6rem); }
  .hero-fig { margin: 0; }
  .hero-fig img { width: 100%; flex: 1; min-height: 320px; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .hero-fig figcaption { margin-top: 0.4rem; font-size: 0.8rem; color: var(--c-muted); text-align: right; }
  @media (max-width: 900px) { .hero-split { grid-template-columns: 1fr; } .hero-fig img { flex: none; min-height: 0; aspect-ratio: 16 / 9; } }
</style>
