---
/**
 * 說明會報名區（/webinar 總覽頁與各場次詳細頁共用）。
 * 報名送 console /api/public/contact（建客戶＋聯絡人＋活動紀錄＋待辦，通知 us@twouring.com）；
 * 勾選電子報者另送 console /subscribe（double opt-in）。
 */
import Icon from './Icon.astro';
import { localizePath } from '../i18n/utils';
import { ROUTES } from '../i18n/ui';
import { company } from '../i18n/company';
import { TOPICS, upcomingSessions, fmtDate, regClosesAt, REG_CUTOFF_NOTE } from '../data/webinars';

interface Props { preselect?: string; compact?: boolean; }
const { preselect, compact = false } = Astro.props;
const ENDPOINT = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? 'https://console.twouring.com/api/public/contact';
const SUBSCRIBE = import.meta.env.PUBLIC_SUBSCRIBE_ENDPOINT ?? 'https://console.twouring.com/subscribe';
const lp = (p: string) => localizePath(p, 'zh');
const upcoming = upcomingSessions();
const industries = ['五金／金屬加工', '螺絲扣件／模具', '汽機車零組件', '機械／工具機／設備', '自行車零件', '塑膠／橡膠', '紡織／成衣', '食品製造', '化工／塗料', '造紙／印刷包裝', '木材家具／建材', '其他製造業', '非製造業'];
const sizes = ['10 人以下', '11–50 人', '51–200 人', '201–500 人', '500 人以上'];
---
  <section class="section section--surface" id="register">
    <div class:list={["container", "reg-grid", { "reg-grid--compact": compact }]}>
      <div class="reg-form">
        <h2>報名說明會</h2>
        <p class="reg-lead">填寫約 1 分鐘，{REG_CUTOFF_NOTE}。資料只用於這場說明會與後續聯繫，不會提供給第三方。</p>

        <form id="webinar-form" data-endpoint={ENDPOINT} data-subscribe={SUBSCRIBE} data-email={company.email} novalidate>
          <div class="field">
            <label for="wf-session">場次 <span class="req" aria-hidden="true">*</span></label>
            <select id="wf-session" name="session" required>
              {upcoming.map((s, i) => (
                <option value={`${fmtDate(s.date, true)} ${s.start} ${TOPICS[s.topic].label}：${TOPICS[s.topic].title}`} data-id={s.id} data-ends={regClosesAt(s)} selected={preselect ? s.id === preselect : i === 0}>
                  {fmtDate(s.date)} {s.start}｜{TOPICS[s.topic].label}：{TOPICS[s.topic].title}
                </option>
              ))}
              <option value="下一輪場次排定後通知我">場次都不方便，排定新場次時通知我</option>
            </select>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="wf-name">姓名 <span class="req" aria-hidden="true">*</span></label>
              <input id="wf-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="wf-title">職稱 <span class="req" aria-hidden="true">*</span></label>
              <input id="wf-title" name="job_title" type="text" required autocomplete="organization-title" placeholder="例：總經理、廠長、管理部經理" />
            </div>
          </div>
          <div class="field">
            <label for="wf-company">公司名稱 <span class="req" aria-hidden="true">*</span></label>
            <input id="wf-company" name="company" type="text" required autocomplete="organization" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="wf-email">公司 Email <span class="req" aria-hidden="true">*</span></label>
              <input id="wf-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="wf-phone">手機 <span class="req" aria-hidden="true">*</span></label>
              <input id="wf-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" pattern="[0-9+\-\s()#]{8,20}" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="wf-industry">產業</label>
              <select id="wf-industry" name="industry">
                <option value="" selected>請選擇</option>
                {industries.map((x) => (<option value={x}>{x}</option>))}
              </select>
            </div>
            <div class="field">
              <label for="wf-size">員工人數</label>
              <select id="wf-size" name="size">
                <option value="" selected>請選擇</option>
                {sizes.map((x) => (<option value={x}>{x}</option>))}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="wf-pain">目前最卡的一個流程（選填）</label>
            <textarea id="wf-pain" name="pain" rows="3" placeholder="例：報價都靠一位老業務，他請假就沒人能報；或料號在三個 Excel 裡對不起來⋯⋯"></textarea>
            <p class="hint">填了會在問答時間優先回答（不會公開你的公司名稱）。</p>
          </div>
          <label class="consent">
            <input type="checkbox" name="newsletter" value="yes" checked />
            <span>同時訂閱遊遊電子報：每週一篇傳產 AI 導入與數位轉型實務，可隨時退訂</span>
          </label>
          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>我已閱讀並同意 <a href={lp(ROUTES.privacy)}>隱私權政策</a></span>
          </label>
          <input type="text" name="company_url" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button type="submit" class="btn btn--primary btn--lg btn--block" id="wf-submit" data-cta="webinar_form_submit">送出報名</button>
          <p class="form-status" id="wf-status" role="status" aria-live="polite"></p>
        </form>

        <div class="form-success" id="wf-success" hidden>
          <span class="success-icon" aria-hidden="true"><Icon name="check" size={32} /></span>
          <h2 tabindex="-1">報名完成，謝謝你！</h2>
          <p>稍後會收到 Google 行事曆邀請，裡面附 Google Meet 連結（沒看到請檢查垃圾信件匣）。若有勾選電子報，請到信箱點一下確認訂閱信。</p>
          <p>等不及說明會？也可以直接 <a href={company.bookingUrl} target="_blank" rel="noopener">預約 30 分鐘初談</a>。</p>
        </div>
      </div>

      {!compact && <aside class="reg-side">
        <div class="card">
          <h3>聽完可以帶走</h3>
          <ul role="list">
            <li><Icon name="check" size={16} /> 一份流程盤點表，回公司就能自己填</li>
            <li><Icon name="check" size={16} /> 說明會簡報與錄影（只寄給報名者）</li>
            <li><Icon name="check" size={16} /> 《報價實況 2026》：導入費用與時程怎麼抓</li>
            <li><Icon name="check" size={16} /> 會後 2 週內預約，可先拿一次 30 分鐘「最卡流程」初診</li>
          </ul>
        </div>
        <div class="card faq">
          <h3>常見問題</h3>
          <p class="q">需要先懂 AI 嗎？</p>
          <p>不用。內容以老闆和主管的角度講流程，不講技術名詞。</p>
          <p class="q">會推銷嗎？</p>
          <p>最後一分鐘會說明我們的服務，其餘時間都是實務內容。要不要往下談由你決定。</p>
          <p class="q">可以帶同事一起嗎？</p>
          <p>可以，建議各自報名，會議連結會分別寄送。</p>
        </div>
      </aside>}
    </div>
  </section>

<style>
  .reg-grid.reg-grid--compact { grid-template-columns: minmax(0, 760px); justify-content: center; }
  .reg-side li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .reg-side :global(svg) { color: var(--c-accent-strong); flex-shrink: 0; margin-top: 4px; }
  .reg-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: start; }
  .reg-form h2 { font-size: var(--fs-700); }
  .reg-lead { color: var(--c-muted); margin: 0.5rem 0 1.4rem; }
  .reg-side { display: grid; gap: 1.2rem; }
  .reg-side h3 { font-size: var(--fs-500); margin-bottom: 0.8rem; }
  .reg-side ul { display: grid; gap: 0.55rem; font-size: 0.94rem; }
  .faq .q { font-family: var(--font-head); font-weight: 700; margin-top: 0.7rem; }
  .faq p:not(.q) { color: var(--c-muted); font-size: 0.92rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .field label { font-family: var(--font-head); font-weight: 700; font-size: 0.92rem; }
  .req { color: var(--c-accent-strong); }
  .hint { color: var(--c-faint); font-size: 0.85rem; }
  .field input, .field select, .field textarea {
    font-family: var(--font-body); font-size: 1rem; color: var(--c-ink);
    padding: 0.7em 0.9em; border: 1.5px solid var(--c-line-strong); border-radius: var(--radius); background: #fff; width: 100%;
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid transparent; outline-offset: 2px; border-color: var(--c-accent); box-shadow: var(--ring); }
  .consent { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0.4rem 0 0.9rem; font-size: 0.92rem; color: var(--c-muted); }
  .consent input { margin-top: 0.25rem; width: 18px; height: 18px; accent-color: var(--c-accent-strong); flex-shrink: 0; }
  .consent a { text-decoration: underline; text-underline-offset: 2px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-status { margin-top: 0.9rem; font-size: 0.92rem; }
  .form-status.error { color: var(--c-accent-strong); }
  .form-success { text-align: center; padding: 2.5rem 1.5rem; border: 1px solid #d7eede; background: #f3faf5; border-radius: var(--radius-lg); }
  .success-icon { display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: #1a8a4f; color: #fff; margin-bottom: 1rem; }
  .form-success h2 { font-size: var(--fs-600); outline: none; }
  .form-success p { color: var(--c-muted); margin-top: 0.5rem; }
  .form-success a { text-decoration: underline; }
  @media (max-width: 820px) {
    .reg-grid, .field-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // 隱藏 build 之後才截止報名的場次（靜態站不會每天重建）。
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('[data-ends]').forEach((el) => {
    if (Number(el.dataset.ends) <= now) el.remove();
  });
  const form = document.getElementById('webinar-form') as HTMLFormElement | null;
  const sel = document.getElementById('wf-session') as HTMLSelectElement | null;
  const statusEl = document.getElementById('wf-status');
  const btn = document.getElementById('wf-submit') as HTMLButtonElement | null;
  const successEl = document.getElementById('wf-success');

  // ?session=YYYY-MM-DD（開發信、電子報連結帶入）
  const qs = new URLSearchParams(location.search).get('session');
  if (qs && sel) {
    const opt = sel.querySelector<HTMLOptionElement>(`option[data-id="${CSS.escape(qs)}"]`);
    if (opt) sel.value = opt.value;
  }

  if (form && btn && statusEl && successEl && sel) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = '';
      statusEl.classList.remove('error');
      if ((form.elements.namedItem('company_url') as HTMLInputElement)?.value) return;
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const fd = new FormData(form);
      const v = (k: string) => String(fd.get(k) ?? '').trim();
      const params = new URLSearchParams(location.search);
      const utm = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => params.get(k) ? `${k}=${params.get(k)}` : '').filter(Boolean).join('&');
      const message = [
        `場次：${v('session')}`,
        `職稱：${v('job_title')}`,
        `手機：${v('phone')}`,
        `產業：${v('industry') || '—'}`,
        `員工人數：${v('size') || '—'}`,
        `訂閱電子報：${v('newsletter') ? '是' : '否'}`,
        `來源：${utm || document.referrer || '直接進站'}`,
        '',
        `最卡的流程：${v('pain') || '（未填）'}`,
      ].join('\n');
      const data = {
        name: v('name'), email: v('email'), company: v('company'),
        type: `說明會報名｜${v('session').split('：')[0]}`,
        message, locale: 'zh', page: location.href,
      };

      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = '送出中⋯';
      try {
        const res = await fetch(form.dataset.endpoint || '', { method: 'POST', body: new URLSearchParams(data) });
        const result = await res.json().catch(() => null);
        if (result && result.error === 'registration_closed') {
          statusEl.classList.add('error');
          statusEl.textContent = '這一場已截止報名（每場報名至前一天中午 12:00），請改選其他場次。';
          btn.disabled = false;
          btn.textContent = label;
          return;
        }
        if (!(res.ok && result && result.ok)) throw new Error(String(res.status));
        if (v('newsletter')) {
          // console /subscribe 回 HTML、不開 CORS；no-cors 只送不讀，失敗不影響報名結果。
          fetch(form.dataset.subscribe || '', { method: 'POST', mode: 'no-cors', body: new URLSearchParams({ email: data.email, name: data.name }) }).catch(() => {});
        }
        (window as any).gtag?.('event', 'webinar_register', { session: v('session').split('：')[0], industry: v('industry') });
        // Google Ads 轉換：說明會報名成功（提交待開發客戶表單）
        (window as any).gtag?.('event', 'conversion', { send_to: 'AW-18568309489/qAvpCLjt_rUdEPHVh5ZF', value: 1.0, currency: 'TWD' });
        form.hidden = true;
        successEl.hidden = false;
        (successEl.querySelector('h2') as HTMLElement | null)?.focus();
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        const mail = form.dataset.email || 'us@twouring.com';
        const href = `mailto:${mail}?subject=${encodeURIComponent(`[說明會報名] ${data.name} ${data.company}`)}&body=${encodeURIComponent(`姓名：${data.name}\nEmail：${data.email}\n公司：${data.company}\n${message}`)}`;
        statusEl.classList.add('error');
        // 安全：href 由 encodeURIComponent 編碼（含引號），mail 來自本站 data 屬性，無使用者原文直接進 HTML。
        statusEl.innerHTML = `送出失敗，請改用 Email 報名：<a href="${href}">${mail}</a>`;
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }
</script>
