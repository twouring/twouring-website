---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CTABand from '../CTABand.astro';
import Icon from '../Icon.astro';
import ProgramsSection from '../ProgramsSection.astro';
import { getLang, localizePath } from '../../i18n/utils';
import { useUI, ROUTES } from '../../i18n/ui';
import { company } from '../../i18n/company';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);

const c = {
  zh: {
    eyebrow: '關於遊遊',
    title: '與客戶同行，把想法走到可落地的下一站',
    lead: 'Twouring 遊遊用 AI、數位工具、軟體與顧問方法，協助企業、政府與城市解決營運、轉型與人才問題。我們把政府專案實績、生態系連結與技術產品能力，整理成可購買、可驗收的顧問服務。',
    storyTitle: '為什麼叫 Twouring 遊遊',
    story: [
      'Twouring 讀音接近 touring，來自 touring / two touring / tw-ouring。「Two」代表你我一起達成目標；「tw-ouring」連結台灣的努力與在地感。',
      '遊遊原為「遊遊有限公司」，因後續有其他股東加入而改制為「遊遊股份有限公司」，是同一品牌脈絡的延續。對外正式名稱一律使用「遊遊股份有限公司」，品牌顯示為「Twouring 遊遊」。',
    ],
    mvTitle: '我們相信的事',
    mv: [
      { icon: 'target', t: '使命', d: '讓城市、企業與場域，把國際人才、遠距工作與 AI，變成可執行、可持續的成長。' },
      { icon: 'globe', t: '願景', d: '成為亞洲數位遊牧、遠距工作與 AI 營運轉型的首選顧問夥伴。' },
      { icon: 'compass', t: '價值', d: '診斷先於方案、成果可驗收、角色與授權清楚切分，不用 AI 當空泛口號。' },
    ],
    kkTitle: '負責人暨主導顧問：徐愷（KK）',
    kkLead: '工程師出身、做過技術副總、自己創業、也投過政府標案。KK 看案子只問兩件事：值不值得做、做了能不能驗收。他會自己寫程式、也會自己寫標書，所以你談的是能落地的方案，不是簡報。',
    kkRolesTitle: '背景與資歷',
    kkRoles: [
      '台灣大學資訊工程學系畢業（雙主修資訊管理），15 年軟體開發經驗',
      '前 MoBagel 技術副總（VP of Engineering，2014–2018）',
      'AWS Certified Solutions Architect – Associate',
      '遊遊股份有限公司負責人；適才科技負責人、言文字負責人；匠說技術長暨共同創辦人',
      '台灣數位遊牧者協會（TDNA）理事長；國發會遊牧臺灣辦公室執行長（2025 年起）',
      'PyCon Taiwan／PyCon JP 2019（東京，英文演講）、Modern Web 講者',
      '中華電信、資策會內訓講師；東吳大學、花蓮慈濟醫院等授課',
      'Microsoft GCR Startup Hackfest 第一名、Salesforce 百萬美金 Hackathon 全球第六名',
    ],
    kkHowTitle: 'KK 怎麼做顧問',
    kkHow: [
      { t: '先診斷，不先賣', d: '30 分鐘初談先確認問題、預算與決策者；不清楚的案子他會直接說不適合做。' },
      { t: '能用現成的就不開發', d: '工程師背景讓他知道哪些該買、哪些該做、哪些根本不用做。' },
      { t: '每個階段都能驗收', d: '需求訪談、PoC、建置分開報價，驗收指標寫在報價裡，過了才往下。' },
    ],
    kkQuote: '不要先買系統，先把最卡的那個流程講清楚。能用現成工具解決的，我不會叫你開發。',
    kkQuoteBy: 'KK',
    kkBook: '直接和 KK 約 30 分鐘',
    kkNote: 'KK 負責需求判斷、關係建立、關鍵提案與品質把關；日常執行由專案團隊承接，讓顧問服務不依賴單一個人。',
    groupTitle: '合作夥伴與治理邊界',
    groupLead: '遊遊是對外的顧問主體；適才、言文字與 TDNA 為長期合作夥伴，各司其職。商業合約一律由遊遊簽署，TDNA 角色另行列明，會員與社群資料不作商業開發。',
    group: [
      { name: '遊遊', role: '顧問 · 專案整合 · PMO', desc: '對外顧問、政府案、城市策略、AI／遠距診斷與專案管理。' },
      { name: '適才科技', role: '系統 · 產品 · 工程', desc: '軟體開發、AI 工具建置、系統導入與工程管理。' },
      { name: '言文字', role: '空間 · 活動 · 社群', desc: '台北車站前的實體場域：活動、工作坊與國際社群接待。' },
      { name: 'TDNA', role: '公益 · 倡議 · 平台', desc: '數位遊牧公共倡議、政策溝通與產業連結（非遊遊商業資產）。' },
    ],
    regTitle: '公司登記資訊',
    metaDescription: '關於遊遊股份有限公司（Twouring 遊遊）：品牌故事、使命願景、主導顧問徐愷（KK）、合作夥伴與治理邊界，以及公司登記資訊。',
  },
  en: {
    eyebrow: 'About Twouring',
    title: 'Walking with clients — taking ideas to the next, deliverable stop',
    lead: 'Twouring uses AI, digital tools, software and advisory to help companies, governments and cities solve operations, transformation and talent problems. We turn government track record, ecosystem links and tech-product capability into advisory you can buy and audit.',
    storyTitle: 'Why “Twouring 遊遊”',
    story: [
      'Twouring sounds like “touring”, from touring / two touring / tw-ouring. “Two” means reaching goals together; “tw-ouring” links to Taiwan’s effort and local sense of place.',
      'We began as “遊遊有限公司” (Twouring Ltd.) and became “遊遊股份有限公司” (Twouring Co., Ltd.) after new shareholders joined — the same brand, continued. Our official name is always Twouring Co., Ltd., shown as the brand “Twouring 遊遊”.',
    ],
    mvTitle: 'What we believe',
    mv: [
      { icon: 'target', t: 'Mission', d: 'Help cities, companies and venues turn international talent, remote work and AI into executable, lasting growth.' },
      { icon: 'globe', t: 'Vision', d: 'Be Asia’s go-to advisory partner for digital nomadism, remote work and AI operations transformation.' },
      { icon: 'compass', t: 'Values', d: 'Diagnosis before pitch, auditable results, clearly split roles and authorisation — and never AI as an empty slogan.' },
    ],
    kkTitle: 'Founder & lead advisor: Kai Hsu (KK)',
    kkLead: 'Engineer by training, former VP of Engineering, founder, and a winner of public tenders. KK asks two questions of any project: is it worth doing, and can it be signed off. He still writes code and writes bids himself, so what you discuss is a plan that ships — not a deck.',
    kkRolesTitle: 'Background',
    kkRoles: [
      'B.S. Computer Science, National Taiwan University (double major in Information Management); 15 years building software',
      'Former VP of Engineering, MoBagel (2014–2018)',
      'AWS Certified Solutions Architect – Associate',
      'Founder of Twouring; founder of Adata and Yan-Wen-Zi; CTO & co-founder of Jiangshuo',
      'Chair, Taiwan Digital Nomad Association (TDNA); Executive Director, NDC Nomad Taiwan Office (since 2025)',
      'Speaker at PyCon Taiwan, PyCon JP 2019 (Tokyo, in English) and Modern Web',
      'Corporate trainer for Chunghwa Telecom and III; lectures at Soochow University and Hualien Tzu Chi Hospital',
      '1st place, Microsoft GCR Startup Hackfest; 6th worldwide, Salesforce $1M Hackathon',
    ],
    kkHowTitle: 'How KK works',
    kkHow: [
      { t: 'Diagnose before selling', d: 'A 30-minute call confirms the problem, budget and decision-maker; if a project is not a fit, he says so.' },
      { t: 'Buy before build', d: 'An engineering background means he knows what to buy, what to build, and what not to do at all.' },
      { t: 'Sign-off at every stage', d: 'Requirements, PoC and build are quoted separately, with acceptance criteria written into the quote.' },
    ],
    kkQuote: 'Don’t buy a system first. Describe the one process that hurts most. If an existing tool solves it, I won’t tell you to build.',
    kkQuoteBy: 'KK',
    kkBook: 'Book 30 minutes with KK',
    kkNote: 'KK leads scoping, relationships, key proposals and quality control; day-to-day delivery is handled by the project team, so advisory never depends on one person.',
    groupTitle: 'Partners & governance boundaries',
    groupLead: 'Twouring is the advisory entity; Adata, Yan-Wen-Zi and TDNA are long-term partners, each with their lane. Commercial contracts are always signed by Twouring; TDNA’s role is listed separately, and member or community data is never used for business development.',
    group: [
      { name: 'Twouring', role: 'Advisory · integration · PMO', desc: 'External advisory, government projects, city strategy, AI/remote diagnostics and PM.' },
      { name: 'Adata', role: 'Systems · product · engineering', desc: 'Software development, AI tooling, system rollout and engineering management.' },
      { name: 'Yan-Wen-Zi', role: 'Space · events · community', desc: 'Physical events, workshops, venue experiments and local community hosting.' },
      { name: 'TDNA', role: 'Non-profit · advocacy · platform', desc: 'Digital-nomad advocacy, policy and industry links (not a Twouring commercial asset).' },
    ],
    regTitle: 'Company registration',
    metaDescription: 'About Twouring Co., Ltd. (Twouring 遊遊): brand story, mission and vision, lead advisor Kai Hsu (KK), partners and governance boundaries, and company registration.',
  },
  ja: {
    eyebrow: '会社概要',
    title: 'お客様と並走し、構想を「納品できる次の一歩」へ',
    lead: 'Twouring（遊遊股份有限公司）は、AI、デジタルツール、ソフトウェア開発、コンサルティングを組み合わせ、企業・行政・都市の運営、変革、人材の課題を解決する台湾の会社です。行政案件の実績、エコシステムとのつながり、プロダクト開発力を、発注・検収しやすいサービスとして提供しています。',
    storyTitle: '社名「Twouring 遊遊」について',
    story: [
      'Twouring は touring に近い響きで、touring / two touring / tw-ouring に由来します。「Two」はお客様と私たちが一緒に目標へ進むこと、「tw-ouring」は台湾（TW）に根ざした取り組みを表しています。',
      '当社は「遊遊有限公司」として創業し、新たな株主の参画に伴い「遊遊股份有限公司」（株式会社に相当）へ改組しました。正式名称は「遊遊股份有限公司（Twouring Co., Ltd.）」、ブランド表記は「Twouring 遊遊」です。',
    ],
    mvTitle: '大切にしていること',
    mv: [
      { icon: 'target', t: 'ミッション', d: '都市・企業・施設が、海外人材、リモートワーク、AI を実行可能で持続的な成長につなげられるようにすること。' },
      { icon: 'globe', t: 'ビジョン', d: 'デジタルノマド、リモートワーク、AI による業務変革で、アジアで最初に声がかかるパートナーになること。' },
      { icon: 'compass', t: 'バリュー', d: '提案より先に診断。成果は検収できる形で。役割と許諾は明確に。AI を空虚なスローガンにしない。' },
    ],
    kkTitle: '代表・リードコンサルタント：徐愷（KK）',
    kkLead: 'エンジニア出身で技術副総裁を経て起業、公共入札の落札経験もあります。KK が案件を見るときの問いは二つだけ。やる価値があるか、検収できるか。いまも自分でコードを書き、入札提案書も自分で書くため、お話しするのはスライドではなく、実際に動く計画です。',
    kkRolesTitle: '経歴',
    kkRoles: [
      '国立台湾大学 資訊工程学科卒（資訊管理学科 ダブルメジャー）、ソフトウェア開発歴15年',
      'MoBagel 元技術副総裁（VP of Engineering、2014–2018）',
      'AWS 認定ソリューションアーキテクト – アソシエイト',
      'Twouring 代表。適才科技・言文字 代表、匠說 CTO 兼共同創業者',
      '台湾デジタルノマド協会（TDNA）理事長。国家発展委員会「遊牧臺灣」事務局 執行長（2025年〜）',
      'PyCon Taiwan、PyCon JP 2019（東京・英語で登壇）、Modern Web 登壇',
      '中華電信・資策会（III）の社内研修講師、東呉大学・花蓮慈済病院などで講義',
      'Microsoft GCR Startup Hackfest 優勝、Salesforce 100万ドルハッカソン 世界6位',
    ],
    kkHowTitle: 'KK のコンサルティングの進め方',
    kkHow: [
      { t: '売る前に診断する', d: '30分のヒアリングで課題、予算、意思決定者を確認します。合わない案件は、はっきりそう申し上げます。' },
      { t: '既存ツールで済むなら開発しない', d: 'エンジニアとしての経験から、買うべきもの、作るべきもの、そもそも不要なものを見分けます。' },
      { t: 'すべての段階で検収できる', d: '要件定義、PoC、構築は別々にお見積りし、検収基準を見積書に明記します。' },
    ],
    kkQuote: 'まずシステムを買うのではなく、いちばん困っている業務をはっきりさせること。既存のツールで解決できるなら、開発は勧めません。',
    kkQuoteBy: 'KK',
    kkBook: 'KK との30分相談を予約',
    kkNote: 'KK は要件の見極め、関係構築、重要な提案と品質管理を担い、日々の実行はプロジェクトチームが担当します。特定の個人に依存しない体制でご支援します。',
    groupTitle: 'パートナーとガバナンス',
    groupLead: '対外的なコンサルティングの主体は Twouring です。適才科技・言文字・TDNA は長期パートナーとしてそれぞれの役割を担います。商取引の契約はすべて Twouring が締結し、TDNA の役割は別途明記します。会員やコミュニティのデータを営業目的に使うことはありません。',
    group: [
      { name: 'Twouring', role: 'コンサル · 統括 · PMO', desc: '外部コンサルティング、行政案件、地域戦略、AI・リモートワーク診断、プロジェクト管理。' },
      { name: '適才科技（Adata）', role: 'システム · プロダクト · 開発', desc: 'ソフトウェア開発、AIツール構築、システム導入、開発マネジメント。' },
      { name: '言文字（Emoji Hub）', role: '拠点 · イベント · コミュニティ', desc: '台北駅前の拠点でのイベント、ワークショップ、地域・海外コミュニティの受け入れ。' },
      { name: 'TDNA', role: '非営利 · 政策提言 · プラットフォーム', desc: 'デジタルノマドの政策提言と業界連携（Twouring の商業資産ではありません）。' },
    ],
    regTitle: '会社登記情報',
    metaDescription: 'Twouring（遊遊股份有限公司）の会社概要：社名の由来、ミッション・ビジョン、代表 徐愷（KK）の経歴、パートナーとガバナンス、会社登記情報。',
  },
}[lang];

const reg = lang === 'ja'
  ? [
      ['正式名称', company.legalName.ja],
      ['旧社名', company.formerName.ja],
      ['統一番号（法人番号）', company.taxId],
      ['設立日', company.founded],
      ['資本金', company.capital],
      ['代表者', company.representative.ja],
      ['登記住所', company.address.ja],
      ['オフィス・打ち合わせ場所', company.operatingAddress.ja],
      ['業種', '702099 その他の経営コンサルティング'],
    ]
  : lang === 'zh'
  ? [
      ['法定名稱', company.legalName.zh + '（Twouring Co., Ltd.）'],
      ['前身', company.formerName.zh],
      ['統一編號', company.taxId],
      ['設立日期', company.founded],
      ['資本總額 / 實收資本額', company.capital],
      ['代表人', company.representative.zh],
      ['登記地址', company.address.zh],
      ['營運／會議地點', company.operatingAddress.zh],
      ['財稅營業項目', '702099 其他管理顧問'],
    ]
  : [
      ['Legal name', company.legalName.en + ' (' + company.legalName.zh + ')'],
      ['Former name', company.formerName.zh + ' (Twouring Ltd.)'],
      ['Tax ID', company.taxId],
      ['Founded', company.founded],
      ['Capital / paid-in', company.capital],
      ['Representative', company.representative.en],
      ['Registered address', company.address.en],
      ['Operating / meeting location', company.operatingAddress.en],
      ['Business category', '702099 Management consulting'],
    ];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '徐愷',
  alternateName: 'Kai Hsu (KK)',
  jobTitle: { zh: '遊遊股份有限公司負責人 / 主導顧問', en: 'Founder & lead advisor, Twouring Co., Ltd.', ja: 'Twouring 代表／リードコンサルタント' }[lang],
  worksFor: { '@id': company.siteUrl + '/#organization' },
  url: company.siteUrl + lp(ROUTES.about),
  alumniOf: { '@type': 'CollegeOrUniversity', name: { zh: '國立臺灣大學', en: 'National Taiwan University', ja: '国立台湾大学' }[lang] },
  hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'AWS Certified Solutions Architect – Associate' },
  sameAs: [company.linkedinKK, 'https://www.youtube.com/watch?v=NLLhYKscuMk'],
};
---
<BaseLayout title={{ zh: '關於遊遊', en: 'About', ja: '会社概要' }[lang]} description={c.metaDescription} path={ROUTES.about} jsonLd={[personLd]}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: t.nav.about }]} />

  <!-- 品牌故事 -->
  <section class="section">
    <div class="container container--narrow">
      <h2 class="eyebrow">{c.storyTitle}</h2>
      <div class="flow story">
        {c.story.map((p) => (<p>{p}</p>))}
      </div>
    </div>
  </section>

  <!-- 使命願景價值 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head center"><h2>{c.mvTitle}</h2></div>
      <div class="grid grid--3">
        {c.mv.map((m) => (
          <div class="card mv-card">
            <span class="mv-icon"><Icon name={m.icon} size={24} /></span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KK -->
  <section class="section">
    <div class="container kk-wrap">
      <div class="kk-aside">
        <img class="kk-photo" src="/kk-portrait.jpg" alt={{ zh: '徐愷（KK）肖像照', en: 'Portrait of Kai Hsu (KK)', ja: '徐愷（KK）のポートレート' }[lang]} width="640" height="965" loading="lazy" />
        <p class="kk-name">{company.representative[lang]}</p>
        <a class="kk-linkedin" href={company.linkedinKK} target="_blank" rel="noopener">LinkedIn →</a>
      </div>
      <div class="kk-body">
        <h2 class="eyebrow">{c.kkTitle}</h2>
        <p class="lead">{c.kkLead}</p>
        <blockquote class="kk-quote">
          <p>「{c.kkQuote}」</p>
          <cite>— {c.kkQuoteBy}</cite>
        </blockquote>
        <h3 class="kk-sub">{c.kkHowTitle}</h3>
        <div class="grid grid--3 kk-how">
          {c.kkHow.map((h) => (
            <div class="kk-how-item">
              <h4>{h.t}</h4>
              <p>{h.d}</p>
            </div>
          ))}
        </div>
        <h3 class="kk-sub">{c.kkRolesTitle}</h3>
        <ul class="kk-roles" role="list">
          {c.kkRoles.map((r) => (<li><Icon name="check" size={18} /> {r}</li>))}
        </ul>
        <p class="kk-note">{c.kkNote}</p>
        <div class="cluster kk-cta">
          <a class="btn btn--primary" href={company.bookingUrl} target="_blank" rel="noopener">{c.kkBook}</a>
          <a class="btn btn--ghost" href={company.linkedinKK} target="_blank" rel="noopener">LinkedIn <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <ProgramsSection surface />

  <!-- 合作夥伴角色 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{c.groupTitle}</p><h2>{c.groupLead}</h2></div>
      <div class="grid grid--4">
        {c.group.map((g) => (
          <div class="card group-card">
            <h3>{g.name}</h3>
            <p class="group-role">{g.role}</p>
            <p class="group-desc">{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 登記資訊 -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section-head"><h2 class="eyebrow"><Icon name="building" size={16} /> {c.regTitle}</h2></div>
      <dl class="reg-table">
        {reg.map(([k, v]) => (<div class="reg-row"><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
      <p class="reg-linkedin">
        <a href={company.linkedin} target="_blank" rel="noopener">
