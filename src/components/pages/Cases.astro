---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CTABand from '../CTABand.astro';
import Icon from '../Icon.astro';
import { getLang, localizePath } from '../../i18n/utils';
import { useUI, ROUTES } from '../../i18n/ui';
import { CASE_LIST, relationLabels } from '../../data/cases';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);
const rel = relationLabels[lang];

const c = {
  zh: {
    eyebrow: '案例與成果',
    title: '公開得標實績與可複製方法',
    lead: '花蓮、臺東為遊遊簽約／得標客戶，並揭露公開契約金額（決標總額，非利潤）。國發會相關為 KK 政策職務經歷；情境案例為匿名類型，不對應特定客戶。',
    disclosure: '角色依「得標客戶／政策經歷／交付夥伴／TDNA 生態系」切分揭露。契約金額取自公開標案資料。',
    govTitle: '政府得標案例（獨立頁）',
    policyTitle: '政策職務與生態系（非付費客戶）',
    scenarioTitle: '情境案例（匿名）',
    scenarioLead: '在客戶尚未授權具名前，以匿名類型呈現合作型態與可複製方法。',
    openCase: '查看完整案例',
    metaDescription:
      '遊遊案例：花蓮雲基地（契約 588 萬）、臺東 TTNomads（契約 240 萬）獨立案例頁，以及企業 AI、場域與國際交流匿名情境。',
    policyCase: {
      tag: '政策經歷',
      client: '國家發展委員會 × 數位遊牧生態系',
      problem: '把數位遊牧推動與國際人才議題，連結成政策、社群與產業可協作的生態系。',
      role: 'KK 任國發會數位遊牧相關職務之專業經歷；非遊遊股份有限公司對國發會的付費客戶合約。',
      did: ['數位遊牧政策推動參與', 'Nomad Taiwan / TDNA 生態系連結', '城市、場域與社群串聯'],
      outcome: '強化台灣數位遊牧生態系的政策與社群連結（角色與授權清楚揭露）。',
    },
    scenarioCases: [
      { tag: '企業 · AI', title: '服務業 AI 營運健檢', desc: '為連鎖服務業盤點流程與工具，產出 AI 導入機會清單與優先順序，先做最值得自動化的三個工作流。' },
      { tag: '場域 · 友善商家', title: '商圈多店國際化共創', desc: '協助商圈 10–20 家商家進行數位遊牧友善改造（Nomad Ready 方法），建立英文資訊、地圖、活動與國際社群曝光。' },
      { tag: '國際 · 參訪', title: '亞洲城市數位遊牧交流', desc: '為海外代表團設計一日城市參訪與單位對接，把交流變成可延續的跨國合作。' },
    ],
    labels: { problem: '問題', role: '角色說明', did: '做了什麼', outcome: '成果' },
  },
  en: {
    eyebrow: 'Work & results',
    title: 'Published awards and repeatable methods',
    lead: 'Hualien and Taitung are Twouring contracted/awarded clients, with public award totals (not profit). NDC items reflect KK’s policy experience; scenario cases are anonymised.',
    disclosure: 'Roles are disclosed as awarded client / policy experience / delivery partner / TDNA ecosystem. Contract amounts come from public tender data.',
    govTitle: 'Awarded government cases (dedicated pages)',
    policyTitle: 'Policy roles & ecosystem (not paid clients)',
    scenarioTitle: 'Scenario cases (anonymised)',
    scenarioLead: 'Until clients authorise named cases, we present the engagement type and repeatable method anonymously.',
    openCase: 'Open full case',
    metaDescription:
      'Twouring work: Hualien Cloud Base (NTD 5.88M award) and Taitung TTNomads (NTD 2.4M award) case pages, plus anonymised AI, venue and exchange scenarios.',
    policyCase: {
      tag: 'Policy experience',
      client: 'National Development Council × nomad ecosystem',
      problem: 'Connect digital-nomad and talent agendas into an ecosystem that policy, community and industry can work on together.',
      role: 'KK’s professional experience in NDC digital-nomad roles — not a Twouring paid-client contract with the NDC.',
      did: ['Contributing to digital-nomad policy', 'Nomad Taiwan / TDNA ecosystem links', 'Connecting cities, venues and community'],
      outcome: 'Stronger policy and community links across Taiwan’s nomad ecosystem (roles disclosed).',
    },
    scenarioCases: [
      { tag: 'Enterprise · AI', title: 'Service-sector AI health-check', desc: 'Mapping process and tooling into an AI opportunity list — automating the three workflows worth it first.' },
      { tag: 'Venue · Friendly shops', title: 'District multi-store internationalisation', desc: 'Helping 10–20 shops go nomad-friendly (Nomad Ready method) with English info, maps, events and global exposure.' },
      { tag: 'International · Visit', title: 'Asia city nomad exchange', desc: 'Designing a one-day city visit and matchmaking for an overseas delegation.' },
    ],
    labels: { problem: 'Problem', role: 'Role', did: 'What we did', outcome: 'Result' },
  },
}[lang];
---
<BaseLayout title={lang === 'zh' ? '案例' : 'Work'} description={c.metaDescription} path={ROUTES.cases}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: t.nav.cases }]} />

  <div class="container disclosure-wrap">
    <p class="disclosure"><Icon name="shield" size={18} /> {c.disclosure}</p>
    <ul class="rel-legend" role="list">
      <li><strong>{rel.awarded}</strong></li>
      <li><strong>{rel.policy}</strong></li>
      <li><strong>{rel.partner}</strong></li>
      <li><strong>{rel.ecosystem}</strong></li>
    </ul>
  </div>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head"><h2 class="eyebrow">{c.govTitle}</h2></div>
      <div class="grid grid--2">
        {CASE_LIST.map((item) => {
          const d = item[lang];
          return (
            <a class="card card--link case-card" href={lp(item.path)}>
              <span class="tag">{d.tag}</span>
              <h3>{d.title}</h3>
              <p class="amount">{d.contractAmount}</p>
              <p>{d.summary}</p>
              <span class="go">{c.openCase} <Icon name="arrow" size={18} /></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head"><h2 class="eyebrow">{c.policyTitle}</h2></div>
      <article class="card case-detail">
        <header class="case-head">
          <span class="tag">{c.policyCase.tag}</span>
          <h3>{c.policyCase.client}</h3>
        </header>
        <div class="case-grid">
          <div><h4>{c.labels.problem}</h4><p>{c.policyCase.problem}</p></div>
          <div><h4>{c.labels.role}</h4><p>{c.policyCase.role}</p></div>
          <div><h4>{c.labels.did}</h4><ul role="list">{c.policyCase.did.map((x) => (<li><Icon name="check" size={15} /> {x}</li>))}</ul></div>
          <div><h4>{c.labels.outcome}</h4><p>{c.policyCase.outcome}</p></div>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="eyebrow">{c.scenarioTitle}</h2>
        <p class="lead">{c.scenarioLead}</p>
      </div>
      <div class="grid grid--3">
        {c.scenarioCases.map((cs) => (
          <article class="card">
            <span class="tag">{cs.tag}</span>
            <h3>{cs.title}</h3>
            <p>{cs.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .disclosure-wrap { margin-top: -0.5rem; display: grid; gap: 1rem; }
  .disclosure { display: flex; gap: 0.6rem; align-items: flex-start; background: var(--c-surface); border-radius: var(--radius); padding: 1rem 1.2rem; color: var(--c-muted); font-size: 0.94rem; }
  .rel-legend { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; font-size: 0.88rem; color: var(--c-muted); }
  .case-card { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .case-card .amount { font-family: var(--font-head); font-weight: 800; color: var(--c-accent-strong); margin: 0; }
  .case-card p { color: var(--c-muted); }
  .go { margin-top: auto; padding-top: 0.6rem; display: inline-flex; align-items: center; gap: 0.4em; color: var(--c-accent-strong); font-family: var(--font-head); font-weight: 700; }
  .case-detail { padding: 1.6rem; }
  .case-head { display: grid; gap: 0.5rem; margin-bottom: 1.2rem; }
  .case-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .case-grid h4 { font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-faint); margin-bottom: 0.4rem; }
  .case-grid p, .case-grid li { color: var(--c-muted); }
  .case-grid ul { display: grid; gap: 0.4rem; }
  .case-grid li { display: flex; gap: 0.4rem; }
  .grid--3 .card { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .grid--3 .card p { color: var(--c-muted); }
  @media (max-width: 720px) { .case-grid { grid-template-columns: 1fr; } }
</style>
