---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CTABand from '../CTABand.astro';
import Icon from '../Icon.astro';
import { getLang, localizePath } from '../../i18n/utils';
import { useUI, ROUTES } from '../../i18n/ui';
import { CASE_LIST, relationLabels } from '../../data/cases';
import { trackStats, engagements, coachingCases } from '../../data/trackRecord';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);
const rel = relationLabels[lang];

const c = {
  zh: {
    pageTitle: '實績',
    eyebrow: '實績與成果',
    title: '兩年內交付的政府、企業與跨國專案',
    lead: '從縣府標案、日本企業系統開發，到醫院 AI 培訓與企業流程自動化。政府案金額取自公開採購資料（決標總額，非利潤）。',
    disclosure: '角色依「得標／簽約客戶、KK 政策職務、交付夥伴、TDNA 生態系」切分揭露；未授權具名的企業以產業類型呈現。',
    govTitle: '政府得標案（獨立案例頁）',
    namedTitle: '企業與海外實績',
    namedLead: '已交付或進行中的正式合作。',
    coachTitle: '企業輔導案例',
    coachLead: '客戶未授權具名，以產業類型呈現；皆為實際執行的輔導。',
    policyTitle: '政策職務與生態系（非付費客戶）',
    openCase: '查看完整案例',
    metaDescription:
      '遊遊實績：花蓮雲基地（NT$588 萬）、臺東 TTNomads（NT$240 萬）兩件縣府得標案、日本 ALION 系統開發月約、大阪市教育委員會學習平台協力開發、花蓮慈濟醫院 AI 工作坊，以及企業流程自動化輔導。',
    policyCase: {
      tag: '政策經歷',
      client: '國家發展委員會 × 數位遊牧生態系',
      problem: '把數位遊牧推動與國際人才議題，連結成政策、社群與產業可協作的生態系。',
      role: 'KK 任國發會數位遊牧辦公室執行長之專業經歷；非遊遊股份有限公司對國發會的付費客戶合約。',
      did: ['數位遊牧簽證上路後的政策推動與國際關係', 'Taiwan Digital Fest 2025 臺北、2026 花東（TDNA 主辦，累計 700+ 人）', '高雄、沖繩等地講座與國際論壇'],
      outcome: '讓遊遊在城市與國際交流專案上，具備第一手的政策脈絡與國際網絡（角色與授權清楚揭露）。',
    },
    labels: { problem: '問題', role: '角色說明', did: '做了什麼', outcome: '成果' },
  },
  en: {
    pageTitle: 'Work',
    eyebrow: 'Work & results',
    title: 'Government, enterprise and cross-border projects delivered in two years',
    lead: 'County-government tenders, engineering for a Japanese company, hospital AI training and business automation. Government values come from public procurement records (award totals, not profit).',
    disclosure: 'Roles are disclosed as awarded/contracted client, KK’s policy role, delivery partner or TDNA ecosystem; companies that have not authorised naming are shown by industry.',
    govTitle: 'Awarded government cases (dedicated pages)',
    namedTitle: 'Enterprise & overseas work',
    namedLead: 'Formal engagements, delivered or in progress.',
    coachTitle: 'Business coaching cases',
    coachLead: 'Shown by industry until clients authorise naming — all are real engagements.',
    policyTitle: 'Policy roles & ecosystem (not paid clients)',
    openCase: 'Open full case',
    metaDescription:
      'Twouring work: Hualien Cloud Base (NT$5.88M) and Taitung TTNomads (NT$2.4M) county tenders, a monthly engineering retainer with ALION (Japan), Osaka City education platform co-development, a Tzu Chi Hospital AI workshop and business automation coaching.',
    policyCase: {
      tag: 'Policy experience',
      client: 'National Development Council × nomad ecosystem',
      problem: 'Connect digital-nomad and talent agendas into an ecosystem that policy, community and industry can work on together.',
      role: 'KK’s professional experience as Executive Director of the NDC Digital Nomad Office — not a Twouring paid-client contract with the NDC.',
      did: ['Policy and international relations after the nomad visa launched', 'Taiwan Digital Fest 2025 Taipei and 2026 East Coast (run by TDNA, 700+ people)', 'Talks and forums from Kaohsiung to Okinawa'],
      outcome: 'First-hand policy context and an international network that Twouring brings to city and exchange projects (roles disclosed).',
    },
    labels: { problem: 'Problem', role: 'Role', did: 'What we did', outcome: 'Result' },
  },
  ja: {
    pageTitle: '実績',
    eyebrow: '実績・成果',
    title: 'この2年で納品してきた、行政・企業・越境プロジェクト',
    lead: '県政府の公共入札、日本企業のシステム開発、病院のAI研修、企業の業務自動化まで。行政案件の金額は公開調達データ（落札総額であり、利益額ではありません）に基づきます。',
    disclosure: '「受託・落札先」「KK の政策関連の役職」「デリバリーパートナー」「TDNA エコシステム」に区別して掲載しています。社名掲載の許諾がない企業は業種で記載しています。',
    govTitle: '行政の落札案件（詳細ページあり）',
    namedTitle: '企業・海外の実績',
    namedLead: '納品済み・進行中の正式なお取引です。',
    coachTitle: '企業支援の事例',
    coachLead: '社名掲載の許諾がないため業種で記載していますが、いずれも実際の支援事例です。',
    policyTitle: '政策関連の役職とエコシステム（有償顧客ではありません）',
    openCase: '詳細を見る',
    metaDescription:
      'Twouring の実績：花蓮県「雲基地」（NT$588万）・台東県「TTNomads」（NT$240万）の公共入札、ALION株式会社とのシステム開発月額契約、大阪市教育委員会の学習基盤の開発協力、花蓮慈済病院のAI研修、企業の業務自動化支援。',
    policyCase: {
      tag: '政策関連の経歴',
      client: '台湾 国家発展委員会 × デジタルノマド・エコシステム',
      problem: 'デジタルノマドと海外人材の議題を、政策・コミュニティ・産業が協働できるエコシステムへつなげること。',
      role: 'KK が国家発展委員会デジタルノマド事務局の執行長を務める個人の経歴であり、Twouring と国家発展委員会との有償契約ではありません。',
      did: ['デジタルノマドビザ開始後の政策推進と国際連携', 'Taiwan Digital Fest 2025 台北・2026 花蓮台東（TDNA主催、累計700名以上）', '高雄から沖縄まで、各地での講演・国際フォーラム'],
      outcome: '自治体・国際交流プロジェクトに、一次情報としての政策文脈と海外ネットワークを持ち込めます（役割と許諾を明示）。',
    },
    labels: { problem: '課題', role: '役割', did: '取り組み', outcome: '成果' },
  },
}[lang];
---
<BaseLayout title={c.pageTitle} description={c.metaDescription} path={ROUTES.cases}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: t.nav.cases }]}>
    <ul class="hero-stats" role="list">
      {trackStats.slice(0, 3).map((s) => (
        <li><strong>{s.n[lang]}</strong><span>{s.l[lang]}</span></li>
      ))}
    </ul>
  </PageHero>

  <div class="container disclosure-wrap">
    <p class="disclosure"><Icon name="shield" size={18} /> {c.disclosure}</p>
    <ul class="rel-legend" role="list">
      <li><strong>{rel.awarded}</strong></li>
      <li><strong>{rel.policy}</strong></li>
      <li><strong>{rel.partner}</strong></li>
      <li><strong>{rel.ecosystem}</strong></li>
    </ul>
  </div>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head"><h2 class="eyebrow">{c.govTitle}</h2></div>
      <div class="grid grid--2">
        {CASE_LIST.map((item) => {
          const d = item[lang];
          return (
            <a class="card card--link case-card" href={lp(item.path)}>
              <span class="tag">{d.tag}</span>
              <h3>{d.title}</h3>
              <p class="amount">{d.contractAmount}</p>
              <p>{d.summary}</p>
              <span class="go">{c.openCase} <Icon name="arrow" size={18} /></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <h2 class="eyebrow">{c.namedTitle}</h2>
        <p class="lead">{c.namedLead}</p>
      </div>
      <div class="grid grid--3">
        {engagements.slice(0, 3).map((e) => (
          <article class="card named-card">
            <span class="tag">{e.tag[lang]}</span>
            <p class="named-client">{e.client[lang]}</p>
            <h3>{e.title[lang]}</h3>
            <p>{e.desc[lang]}</p>
            <ul class="named-points" role="list">
              {e.points[lang].map((x) => (<li><Icon name="check" size={15} /> {x}</li>))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="eyebrow">{c.coachTitle}</h2>
        <p class="lead">{c.coachLead}</p>
      </div>
      <div class="grid grid--4 coach-grid">
        {coachingCases.map((cs) => (
          <article class="card">
            <span class="tag">{cs.tag[lang]}</span>
            <h3>{cs.title[lang]}</h3>
            <p>{cs.desc[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head"><h2 class="eyebrow">{c.policyTitle}</h2></div>
      <article class="card case-detail">
        <header class="case-head">
          <span class="tag">{c.policyCase.tag}</span>
          <h3>{c.policyCase.client}</h3>
        </header>
        <div class="case-grid">
          <div><h4>{c.labels.problem}</h4><p>{c.policyCase.problem}</p></div>
          <div><h4>{c.labels.role}</h4><p>{c.policyCase.role}</p></div>
          <div><h4>{c.labels.did}</h4><ul role="list">{c.policyCase.did.map((x) => (<li><Icon name="check" size={15} /> {x}</li>))}</ul></div>
          <div><h4>{c.labels.outcome}</h4><p>{c.policyCase.outcome}</p></div>
        </div>
      </article>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .disclosure-wrap { margin-top: -0.5rem; display: grid; gap: 1rem; }
  .disclosure { display: flex; gap: 0.6rem; align-items: flex-start; background: var(--c-surface); border-radius: var(--radius); padding: 1rem 1.2rem; color: var(--c-muted); font-size: 0.94rem; }
  .rel-legend { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; font-size: 0.88rem; color: var(--c-muted); }
  .case-card { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .case-card .amount { font-family: var(--font-head); font-weight: 800; color: var(--c-accent-strong); margin: 0; }
  .case-card p { color: var(--c-muted); }
  .go { margin-top: auto; padding-top: 0.6rem; display: inline-flex; align-items: center; gap: 0.4em; color: var(--c-accent-strong); font-family: var(--font-head); font-weight: 700; }
  .case-detail { padding: 1.6rem; }
  .case-head { display: grid; gap: 0.5rem; margin-bottom: 1.2rem; }
  .case-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .case-grid h4 { font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-faint); margin-bottom: 0.4rem; }
  .case-grid p, .case-grid li { color: var(--c-muted); }
  .case-grid ul { display: grid; gap: 0.4rem; }
  .case-grid li { display: flex; gap: 0.4rem; }
  .grid--3 .card { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .grid--3 .card p { color: var(--c-muted); }
  .hero-stats { margin-top: 1.6rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 900px; }
  .hero-stats li { display: grid; gap: 0.25rem; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); padding: 0.9rem 1rem; }
  .hero-stats strong { font-family: var(--font-head); font-weight: 800; font-size: var(--fs-600); color: var(--c-accent-strong); }
  .hero-stats span { color: var(--c-muted); font-size: 0.86rem; line-height: 1.45; }
  .named-card { display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; background: #fff; }
  .named-client { font-family: var(--font-head); font-weight: 700; color: var(--c-accent-strong); font-size: 0.92rem; }
  .named-card p { color: var(--c-muted); }
  .named-points { display: grid; gap: 0.35rem; }
  .named-points li { display: flex; gap: 0.4rem; font-size: 0.9rem; color: var(--c-ink); }
  .coach-grid .card { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .coach-grid .card p { color: var(--c-muted); font-size: 0.94rem; }
  @media (max-width: 960px) { .coach-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) { .case-grid { grid-template-columns: 1fr; } .hero-stats { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .coach-grid { grid-template-columns: 1fr; } }
</style>
