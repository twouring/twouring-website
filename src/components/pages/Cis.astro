      ['表記', '正式名称は「遊遊股份有限公司（Twouring Co., Ltd.）」、ブランド名は「Twouring 遊遊」。ワードマークは常に小文字の twouring です。'],
    ],
    colorTitle: 'カラー',
    colorLead: 'LogoAI のビジュアルアイデンティティに基づく4色です。赤はアクセントカラーとして強調に使い、全面の背景色には使いません。',
    colors: [
      ['Background', '#ffffff', '背景'],
      ['Main', '#333333', 'メイン：見出し・本文'],
      ['Auxiliary 1', '#ff0844', 'アクセント1：強調・グラデーション・アイコン'],
      ['Auxiliary 2', '#ffb199', 'アクセント2：暖色の面・装飾'],
    ],
    a11yTitle: 'アクセシビリティに関する補足',
    a11yText: 'ブランドレッド #ff0844 上の白文字はコントラストが不足します（約3.6:1）。Webサイトや社内ツールの文字・塗りボタンには濃い #d80038（約5.3:1、WCAG AA準拠）を使い、元の赤はグラデーションと装飾に限定しています。',
    gradientLabel: 'ブランドグラデーション',
    typeTitle: '書体',
    typeLead: 'ロゴと見出しは Nunito、タグラインと本文は Source Sans 3。日本語・中国語はシステムフォントで補います。いずれも SIL Open Font License で自由に利用できます。',
    headSample: 'Tour your life together',
    bodySample: 'テクノロジーで、企業・行政・都市の課題を解決する。',
    sloganTitle: 'タグライン',
    sloganText: 'タグラインは「Tour your life together」で固定です。ロゴと併用する際は字間を空けた大文字で、文中で引用する場合は通常の表記にします。',
    contact: '他の形式が必要な場合やご不明点は、こちらまで：',
  },
}[lang];

const variants = [
  { key: 'main', img: '/brand/twouring-logo.svg', bg: 'light', files: [['SVG', '/brand/twouring-logo.svg'], ['PNG', '/brand/twouring-logo.png'], ['PDF', '/brand/twouring-logo.pdf']] },
  { key: 'wordmark', img: '/brand/twouring-wordmark.svg', bg: 'light', files: [['SVG', '/brand/twouring-wordmark.svg']] },
  { key: 'symbol', img: '/brand/twouring-symbol.svg', bg: 'light', files: [['SVG', '/brand/twouring-symbol.svg'], ['PNG', '/brand/twouring-symbol.png']] },
  { key: 'white', img: '/brand/twouring-logo-white.svg', bg: 'dark', files: [['SVG', '/brand/twouring-logo-white.svg'], ['PNG', '/brand/twouring-logo-white.png']] },
  { key: 'black', img: '/brand/twouring-logo-black.svg', bg: 'light', files: [['SVG', '/brand/twouring-logo-black.svg'], ['PNG', '/brand/twouring-logo-black.png']] },
] as const;
---
<BaseLayout title={c.eyebrow} description={c.metaDescription} path={ROUTES.cis}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: c.eyebrow }]} />

  <section class="section" id="logo">
    <div class="container">
      <div class="section-head">
        <h2>{c.logoTitle}</h2>
        <p class="lead">{c.logoLead}</p>
      </div>
      <ul class="grid grid--2 logo-grid" role="list">
        {variants.map((v) => (
          <li class="card logo-card">
            <div class:list={['logo-stage', `logo-stage--${v.bg}`]}>
              <img src={v.img} alt={c.variants[v.key]} loading="lazy" />
            </div>
            <div class="logo-meta">
              <h3>{c.variants[v.key]}</h3>
              <p class="downloads">
                <span>{c.download}</span>
                {v.files.map(([label, href]) => (
                  <a class="tag" href={href} download>{label}</a>
                ))}
              </p>
            </div>
          </li>
        ))}
      </ul>

      <h3 class="rules-title">{c.rulesTitle}</h3>
      <ol class="rules" role="list">
        {c.rules.map(([title, text]) => (
          <li><strong>{title}</strong><span>{text}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--surface" id="color">
    <div class="container">
      <div class="section-head">
        <h2>{c.colorTitle}</h2>
        <p class="lead">{c.colorLead}</p>
      </div>
      <ul class="grid grid--4 swatches" role="list">
        {c.colors.map(([name, hex, use]) => (
          <li class="card swatch">
            <div class="swatch-chip" style={`background:${hex}`}></div>
            <div class="swatch-meta">
              <h3>{name}</h3>
              <code>{hex}</code>
              <p>{use}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="card gradient-card">
        <div class="swatch-chip swatch-chip--grad"></div>
        <div class="swatch-meta">
          <h3>{c.gradientLabel}</h3>
          <code>linear-gradient(118deg, #ff0844 0%, #ff5f74 52%, #ffb199 100%)</code>
        </div>
      </div>
      <div class="a11y">
        <h3>{c.a11yTitle}</h3>
        <p>{c.a11yText}</p>
        <p class="downloads">
          <span class="chip" style="background:#ff0844">#ff0844</span>
          <span class="chip" style="background:#d80038">#d80038</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="type">
    <div class="container">
      <div class="section-head">
        <h2>{c.typeTitle}</h2>
        <p class="lead">{c.typeLead}</p>
      </div>
      <div class="grid grid--2">
        <div class="card type-card">
          <p class="type-name">Nunito <span>800 / 700 / 600</span></p>
          <p class="type-sample type-sample--head">{c.headSample}</p>
          <p class="type-sample type-sample--head" lang="en">twouring</p>
          <a href="https://fonts.google.com/specimen/Nunito" target="_blank" rel="noopener">Google Fonts ↗</a>
        </div>
        <div class="card type-card">
          <p class="type-name">Source Sans 3 <span>600 / 400</span></p>
          <p class="type-sample type-sample--body">{c.bodySample}</p>
          <p class="type-sample type-sample--slogan">TOUR YOUR LIFE TOGETHER</p>
          <a href="https://fonts.google.com/specimen/Source+Sans+3" target="_blank" rel="noopener">Google Fonts ↗</a>
        </div>
      </div>
      <div class="a11y">
        <h3>{c.sloganTitle}</h3>
        <p>{c.sloganText}</p>
      </div>
      <p class="contact">{c.contact} <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .logo-grid { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .logo-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .logo-stage { display: grid; place-items: center; padding: clamp(1.5rem, 4vw, 2.6rem); min-height: 220px; }
  .logo-stage--light { background: var(--c-surface); background-image: linear-gradient(45deg, var(--c-line) 25%, transparent 25%, transparent 75%, var(--c-line) 75%), linear-gradient(45deg, var(--c-line) 25%, transparent 25%, transparent 75%, var(--c-line) 75%); background-size: 20px 20px; background-position: 0 0, 10px 10px; }
  .logo-stage--dark { background: var(--c-surface-ink); }
  .logo-stage img { max-height: 160px; width: auto; }
  .logo-meta { padding: var(--sp-4) var(--sp-5) var(--sp-5); }
  .logo-meta h3 { font-size: var(--fs-500); margin-bottom: var(--sp-2); }
  .downloads { display: flex; flex-wrap: wrap; gap: var(--sp-2); align-items: center; color: var(--c-muted); font-size: var(--fs-300); }

  .rules-title { margin-bottom: var(--sp-4); }
  .rules { display: grid; gap: var(--sp-3); counter-reset: rule; }
  .rules li { display: grid; grid-template-columns: 2.2rem 1fr; gap: var(--sp-1) var(--sp-3); padding: var(--sp-4) var(--sp-5); border: 1px solid var(--c-line); border-radius: var(--radius); background: var(--c-bg); counter-increment: rule; }
  .rules li::before { content: counter(rule, decimal-leading-zero); grid-row: 1 / span 2; font-family: var(--font-head); font-weight: 800; color: var(--c-accent-strong); }
  .rules strong { font-family: var(--font-head); color: var(--c-ink-strong); }
  .rules span { color: var(--c-muted); }

  .swatches { margin-bottom: var(--sp-5); }
  .swatch, .gradient-card { padding: 0; overflow: hidden; }
  .swatch-chip { height: 150px; border-bottom: 1px solid var(--c-line); }
  .swatch-chip--grad { background: var(--grad-brand); }
  .swatch-meta { padding: var(--sp-4) var(--sp-5); }
  .swatch-meta h3 { font-size: var(--fs-500); }
  .swatch-meta code { display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: var(--fs-300); background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-sm); padding: 0.15em 0.5em; margin-block: var(--sp-2); }
  .swatch-meta p { color: var(--c-muted); font-size: var(--fs-300); }
  .gradient-card { margin-bottom: var(--sp-6); }

  .a11y { max-width: 60ch; margin-top: var(--sp-6); }
  .a11y h3 { margin-bottom: var(--sp-2); }
  .a11y p { color: var(--c-muted); }
  .a11y .downloads { margin-top: var(--sp-3); }
  .chip { display: inline-block; color: #fff; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: var(--fs-300); padding: 0.6em 1em; border-radius: var(--radius-sm); }

  .type-card { display: flex; flex-direction: column; gap: var(--sp-3); }
  .type-name { font-family: var(--font-head); font-weight: 800; font-size: var(--fs-600); color: var(--c-ink-strong); }
  .type-name span { font-weight: 400; color: var(--c-muted); font-size: var(--fs-300); margin-left: 0.5em; }
  .type-sample--head { font-family: var(--font-head); font-weight: 800; font-size: var(--fs-800); line-height: 1.1; color: var(--c-ink-strong); }
  .type-sample--body { font-size: var(--fs-500); }
  .type-sample--slogan { font-family: var(--font-body); font-weight: 600; letter-spacing: 0.12em; color: var(--c-brand-ink); }
  .type-card a { margin-top: auto; font-size: var(--fs-300); }
  .contact { margin-top: var(--sp-6); color: var(--c-muted); }
</style>
