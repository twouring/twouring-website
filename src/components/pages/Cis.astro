    logoTitle: 'Logo',
    logoLead: 'The primary logo combines the symbol, the “twouring” wordmark and the tagline. Use the full version whenever possible; fall back to the wordmark or symbol in tight spaces.',
    variants: {
      main: 'Primary logo (colour)',
      wordmark: 'Without tagline',
      symbol: 'Symbol',
      white: 'White (on dark backgrounds)',
      black: 'Black (single-colour print)',
    },
    download: 'Download:',
    vector: 'Vector',
    rulesTitle: 'Usage rules',
    rules: [
      ['Clear space', 'Keep at least half the symbol’s height clear on every side. No text or graphics inside that area.'],
      ['Minimum size', 'Full logo: no narrower than 120px on screen or 25mm in print. Symbol: no smaller than 24px.'],
