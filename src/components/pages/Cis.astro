      ['Auxiliary 1', '#ff0844', 'Accent 1: highlights, gradients, icons'],
      ['Auxiliary 2', '#ffb199', 'Accent 2: warm surfaces and decoration'],
    ],
    a11yTitle: 'Digital accessibility note',
    a11yText: 'White text on brand red #ff0844 falls short of contrast requirements (about 3.6:1). On the website and internal tools, text and solid buttons use the deeper #d80038 (about 5.3:1, WCAG AA); the original red is reserved for gradients and decoration.',
    gradientLabel: 'Brand gradient',
    typeTitle: 'Typography',
    typeLead: 'Nunito for the logo and headings, Source Sans 3 for the tagline and body copy. Chinese text falls back to system fonts (Noto Sans TC / PingFang TC / Microsoft JhengHei). Both typefaces are under the SIL Open Font License.',
