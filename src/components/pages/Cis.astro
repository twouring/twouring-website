      white: '白（濃色背景用）',
      black: '黒（単色印刷用）',
    },
    download: 'ダウンロード：',
    vector: 'ベクター',
    rulesTitle: '使用ルール',
    rules: [
      ['余白', 'ロゴの周囲にはシンボルの高さの半分以上の余白を確保し、文字や図形を置かないでください。'],
