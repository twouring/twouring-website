---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { getLang, localizePath } from '../../i18n/utils';
import { useUI, ROUTES } from '../../i18n/ui';
import { company } from '../../i18n/company';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);

// 預設送到 console（建客戶＋通知 us@twouring.com）；設 PUBLIC_CONTACT_ENDPOINT 可覆寫，失敗時前端退回 mailto。
const ENDPOINT = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? 'https://console.twouring.com/api/public/contact';

const c = {
  zh: {
    eyebrow: '聯絡我們',
    title: '預約 30 分鐘需求初談，或留下你的需求',
    lead: '可以直接預約時段，或填寫下方表單，我們會在兩個工作日內回覆。',
    metaDescription: '聯絡遊遊股份有限公司（Twouring 遊遊）：預約 30 分鐘企業 AI 導入與城市數位轉型需求初談。聯絡信箱 us@twouring.com。',
    bookTitle: '想直接約時間？',
    bookText: '挑一個方便的時段，直接預約 30 分鐘線上需求初談。',
    bookBtn: '預約 30 分鐘時段',
    orLeave: '或在下方留下需求',
    prepareTitle: '會議前，可以先準備',
    prepare: ['你想解決的問題或目標', '目前的進度與既有資源', '時程與大致預算範圍', '誰是決策者與內部窗口'],
    form: {
      name: '姓名', company: '公司或單位名稱', email: '電子郵件', type: '諮詢項目', message: '需求說明',
      typePlaceholder: '請選擇',
      types: ['企業 AI 導入顧問', 'AI 內訓 / 流程自動化', '系統開發與整合（ERP／CRM／報價訂單）', '遊遊愛馬仕 AI 工作空間（訂閱）', '遠距與混合工作制度', '城市與政府（數位遊牧城市策略）', '場域與商家（友善場域／旅宿國際化）', '國際企業參訪', '補助 / 標案策略', '演講 / 工作坊 / 其他'],
      messagePlaceholder: '請簡述目前狀況、目標與預計時程',
      consent: '我已閱讀並同意',
      privacy: '隱私權政策',
      submit: '送出需求',
      sending: '送出中⋯',
      successTitle: '已收到你的需求',
      success: '我們會在兩個工作日內回覆，並安排 30 分鐘需求初談。若屆時未收到回覆，請改寄 us@twouring.com。',
      errorTitle: '送出失敗',
      error: '請改用 Email 直接聯絡我們：',
      required: '此欄位為必填',
    },
    infoTitle: '其他聯絡方式',
    emailLabel: '電子郵件',
    addrLabel: '登記地址',
    operatingLabel: '營運／會議地點',
    linkedinLabel: 'LinkedIn（主要正式渠道）',
    note: '我們以 LinkedIn 作為主要正式社群渠道；目前不經營 Instagram 與 Facebook。公司正式名稱：Twouring 遊遊｜遊遊股份有限公司。',
  },
  en: {
    eyebrow: 'Contact',
    title: 'Book a 30-minute discovery call or send us your request',
    lead: 'Book a time directly, or fill in the form below and we will reply within two business days.',
    metaDescription: 'Contact Twouring Co., Ltd. (Twouring 遊遊): book a 30-minute enterprise AI and city digital-transformation discovery call. Email us@twouring.com.',
    bookTitle: 'Prefer to pick a time?',
    bookText: 'Choose a slot that suits you and book a 30-minute online discovery call directly.',
    bookBtn: 'Book a 30-min slot',
    orLeave: 'Or leave your details below',
    prepareTitle: 'Before the call, it helps to have',
    prepare: ['The problem or goal you want to solve', 'Current progress and existing resources', 'Timeline and rough budget range', 'Who the decision-maker and internal contact are'],
    form: {
      name: 'Name', company: 'Company or organisation', email: 'Email', type: 'Topic', message: 'Details of your request',
      typePlaceholder: 'Please select',
      types: ['Enterprise AI consulting', 'AI training / workflow automation', 'Systems & integration (ERP / CRM / quoting & orders)', 'Twouring Hermes AI workspace (subscription)', 'Remote & hybrid work systems', 'Cities & government (nomad city strategy)', 'Venues & hospitality internationalisation', 'Taiwan business delegation / visits', 'Grants / tender strategy', 'Talks / workshops / other'],
      messagePlaceholder: 'Briefly describe your current situation, goals and timeline',
      consent: 'I have read and agree to the',
      privacy: 'Privacy Policy',
      submit: 'Submit request',
      sending: 'Sending…',
      successTitle: 'Your request has been received',
      success: 'We will reply within two business days to arrange a 30-minute discovery call. If you have not heard from us by then, please email us@twouring.com.',
      errorTitle: 'Submission failed',
      error: 'Please email us directly instead:',
      required: 'This field is required',
    },
    infoTitle: 'Other ways to reach us',
    emailLabel: 'Email',
    addrLabel: 'Registered address',
    operatingLabel: 'Operating / meeting location',
    linkedinLabel: 'LinkedIn (primary official channel)',
    note: 'LinkedIn is our primary official channel; we do not currently run Instagram or Facebook accounts. Official company name: Twouring 遊遊 | Twouring Co., Ltd.',
  },
  ja: {
    eyebrow: 'お問い合わせ',
    title: '30分の無料ヒアリングのご予約、またはご相談内容の送信',
    lead: '日時を直接ご予約いただくか、下記フォームからご相談内容をお送りください。2営業日以内にご返信します。日本語でのご相談も歓迎です。',
    metaDescription: 'Twouring（遊遊股份有限公司）へのお問い合わせ：企業AI導入・地域DXに関する30分の無料ヒアリングをご予約いただけます。日本語対応可。us@twouring.com',
    bookTitle: '日時を指定して予約',
    bookText: 'ご都合のよい時間を選んで、30分のオンラインヒアリングをご予約ください。',
    bookBtn: '30分の枠を予約する',
    orLeave: 'または、下記フォームからご相談ください',
    prepareTitle: '事前にご準備いただくとスムーズです',
    prepare: ['解決したい課題・目標', '現在の進捗と既存のリソース', 'スケジュールとおおよその予算感', '意思決定者と社内のご担当窓口'],
    form: {
      name: 'お名前', company: '会社名・団体名', email: 'メールアドレス', type: 'ご相談のテーマ', message: 'ご相談内容',
      typePlaceholder: '選択してください',
      types: ['企業AI導入コンサルティング', 'AI研修・業務自動化', 'システム開発・統合（ERP／CRM／見積・受注）', 'Twouring Hermes AIワークスペース（サブスクリプション）', 'リモート・ハイブリッドワーク制度', '自治体・行政（デジタルノマド誘致戦略）', '施設・店舗（ノマドフレンドリー化・宿泊のインバウンド対応）', '台湾視察・企業訪問', '補助金・入札の戦略支援', '講演・ワークショップ・その他'],
      messagePlaceholder: '現状、目標、スケジュールなどを簡単にご記入ください',
      consent: '以下に同意します：',
      privacy: 'プライバシーポリシー',
      submit: '送信する',
      sending: '送信中…',
      successTitle: '送信が完了しました',
      success: '2営業日以内にご返信し、30分のヒアリング日程をご案内します。返信が届かない場合は us@twouring.com までご連絡ください。',
      errorTitle: '送信できませんでした',
      error: 'お手数ですが、メールで直接ご連絡ください：',
      required: '必須項目です',
    },
    infoTitle: 'その他の連絡先',
    emailLabel: 'メール',
    addrLabel: '登記住所',
    operatingLabel: 'オフィス・打ち合わせ場所',
    linkedinLabel: 'LinkedIn（公式チャネル）',
    note: 'LinkedIn を公式チャネルとしています（Instagram・Facebook は運用していません）。正式名称：Twouring 遊遊｜遊遊股份有限公司。',
  },
}[lang];
---
<BaseLayout title={{ zh: '聯絡我們', en: 'Contact', ja: 'お問い合わせ' }[lang]} description={c.metaDescription} path={ROUTES.contact}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: t.nav.contact }]} />

  <section class="section section--tight">
    <div class="container contact-grid">
      <!-- 表單 -->
      <div class="form-col">
        <div class="book-callout">
          <div class="book-copy">
            <h2>{c.bookTitle}</h2>
            <p>{c.bookText}</p>
          </div>
          <a class="btn btn--primary" href={company.bookingUrl} target="_blank" rel="noopener">{c.bookBtn}</a>
        </div>
        <p class="or-divider"><span>{c.orLeave}</span></p>

        <form id="contact-form" data-endpoint={ENDPOINT} data-email={company.email} novalidate>
          <div class="field-row">
            <div class="field">
              <label for="cf-name">{c.form.name} <span class="req" aria-hidden="true">*</span></label>
              <input id="cf-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="cf-company">{c.form.company}</label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" />
            </div>
          </div>
          <div class="field">
            <label for="cf-email">{c.form.email} <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="cf-type">{c.form.type}</label>
            <select id="cf-type" name="type">
              <option value="" disabled selected>{c.form.typePlaceholder}</option>
              {c.form.types.map((ty) => (<option value={ty}>{ty}</option>))}
            </select>
          </div>
          <div class="field">
            <label for="cf-message">{c.form.message} <span class="req" aria-hidden="true">*</span></label>
            <textarea id="cf-message" name="message" rows="5" required placeholder={c.form.messagePlaceholder}></textarea>
          </div>
          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>{c.form.consent} <a href={lp(ROUTES.privacy)}>{c.form.privacy}</a></span>
          </label>
          <input type="text" name="company_url" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button type="submit" class="btn btn--primary btn--lg btn--block" id="cf-submit" data-sending={c.form.sending}>{c.form.submit}</button>
          <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
        </form>

        <div class="form-success" id="cf-success" hidden>
          <span class="success-icon" aria-hidden="true"><Icon name="check" size={30} /></span>
          <h2 tabindex="-1">{c.form.successTitle}</h2>
          <p>{c.form.success}</p>
        </div>
      </div>

      <!-- 側欄資訊 -->
      <aside class="info-col">
        <div class="info-card">
          <h2>{c.infoTitle}</h2>
          <ul class="info-list" role="list">
            <li>
              <span class="info-ic"><Icon name="mail" size={18} /></span>
              <div><span class="info-label">{c.emailLabel}</span><a href={`mailto:${company.email}`}>{company.email}</a></div>
            </li>
            <li>
              <span class="info-ic"><Icon name="pin" size={18} /></span>
              <div><span class="info-label">{c.addrLabel}</span><span>{company.address[lang]}</span></div>
            </li>
            <li>
              <span class="info-ic"><Icon name="building" size={18} /></span>
              <div><span class="info-label">{c.operatingLabel}</span><span>{company.operatingAddress[lang]}</span></div>
            </li>
            <li>
              <span class="info-ic"><Icon name="users" size={18} /></span>
              <div><span class="info-label">{c.linkedinLabel}</span><a href={company.linkedin} target="_blank" rel="noopener">{company.brand}</a></div>
            </li>
          </ul>
          <p class="info-note">{c.note}</p>
        </div>

        <div class="prepare-card">
          <h3>{c.prepareTitle}</h3>
          <ul role="list">{c.prepare.map((p) => (<li><Icon name="check" size={16} /> {p}</li>))}</ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: start; }
  .book-callout { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; flex-wrap: wrap; background: var(--grad-soft); border: 1px solid #ffe0d6; border-radius: var(--radius-lg); padding: 1.3rem 1.5rem; }
  .book-copy h2 { font-size: var(--fs-500); }
  .book-copy p { color: var(--c-muted); font-size: 0.94rem; margin-top: 0.3rem; }
  .book-callout .btn { flex-shrink: 0; }
  .or-divider { display: flex; align-items: center; gap: 0.9rem; color: var(--c-faint); font-size: 0.88rem; margin: 1.6rem 0; }
  .or-divider::before, .or-divider::after { content: ""; flex: 1; height: 1px; background: var(--c-line); }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .field label { font-family: var(--font-head); font-weight: 700; font-size: 0.92rem; }
  .req { color: var(--c-accent-strong); }
  .field input, .field select, .field textarea {
    font-family: var(--font-body); font-size: 1rem; color: var(--c-ink);
    padding: 0.7em 0.9em; border: 1.5px solid var(--c-line-strong); border-radius: var(--radius); background: #fff; width: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field textarea { resize: vertical; }
  /* 透明 outline 在 Windows forced-colors 模式會被系統色描出，保住焦點框 */
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid transparent; outline-offset: 2px; border-color: var(--c-accent); box-shadow: var(--ring); }

  .consent { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0.4rem 0 1.2rem; font-size: 0.92rem; color: var(--c-muted); }
  .consent input { margin-top: 0.25rem; width: 18px; height: 18px; accent-color: var(--c-accent-strong); flex-shrink: 0; }
  .consent a { text-decoration: underline; text-underline-offset: 2px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .form-status { margin-top: 0.9rem; font-size: 0.92rem; }
  .form-status.error { color: var(--c-accent-strong); }
  .form-success { text-align: center; padding: 2.5rem 1.5rem; border: 1px solid #d7eede; background: #f3faf5; border-radius: var(--radius-lg); }
  .success-icon { display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: #1a8a4f; color: #fff; margin-bottom: 1rem; }
  .form-success h2 { font-size: var(--fs-600); }
  .form-success p { color: var(--c-muted); margin-top: 0.5rem; }

  .info-card, .prepare-card { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-lg); padding: 1.6rem; }
  .prepare-card { margin-top: 1.2rem; }
  .info-card h2 { font-size: var(--fs-500); margin-bottom: 1.2rem; }
  .info-list { display: grid; gap: 1.1rem; }
  .info-list li { display: flex; gap: 0.8rem; align-items: flex-start; }
  .info-ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #fff; color: var(--c-accent-strong); flex-shrink: 0; box-shadow: var(--shadow-sm); }
  .info-label { display: block; font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--c-faint); font-weight: 700; font-family: var(--font-head); }
  .info-note { margin-top: 1.2rem; font-size: 0.85rem; color: var(--c-faint); }
  .prepare-card h3 { font-size: var(--fs-500); margin-bottom: 1rem; }
  .prepare-card ul { display: grid; gap: 0.6rem; }
  .prepare-card li { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.94rem; }
  .prepare-card :global(svg) { color: var(--c-accent-strong); flex-shrink: 0; margin-top: 3px; }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('cf-status');
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const successEl = document.getElementById('cf-success');

  const EMAIL = form?.dataset.email || 'us@twouring.com';
  const IS_EN = document.documentElement.lang.startsWith('en');
  const IS_JA = document.documentElement.lang.startsWith('ja');

  function buildMailto(data: Record<string, string>): string {
    const L = IS_EN
      ? { subj: '[Website inquiry]', name: 'Name', company: 'Organisation', email: 'Email', topic: 'Topic' }
      : IS_JA
        ? { subj: '[Webお問い合わせ]', name: 'お名前', company: '会社名', email: 'Email', topic: 'テーマ' }
        : { subj: '[官網詢問]', name: '姓名', company: '單位', email: 'Email', topic: '方向' };
    const subject = encodeURIComponent(`${L.subj} ${data.name || ''} ${data.company || ''}`.trim());
    const body = encodeURIComponent(
      `${L.name}: ${data.name || ''}\n${L.company}: ${data.company || ''}\n${L.email}: ${data.email || ''}\n${L.topic}: ${data.type || ''}\n\n${data.message || ''}`,
    );
    return `mailto:${EMAIL}?subject=${subject}&body=${body}`;
  }

  if (form && submitBtn && statusEl && successEl) {
    const sendingLabel = submitBtn.dataset.sending || '送出中⋯ / Sending…';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = '';
      statusEl.classList.remove('error');

      // honeypot：若被填寫視為機器人，直接忽略
      if ((form.elements.namedItem('company_url') as HTMLInputElement)?.value) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const fd = new FormData(form);
      const data: Record<string, string> = {};
      fd.forEach((v, k) => { if (k !== 'company_url') data[k] = String(v); });
      data.locale = document.documentElement.lang;
      data.page = location.href;

      const endpoint = form.dataset.endpoint || '';
      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = sendingLabel;

      const showSuccess = () => {
        form.hidden = true;
        successEl.hidden = false;
        // 把焦點移入成功標題，讓螢幕報讀者收到回饋（標題帶 tabindex="-1"）。
        (successEl.querySelector('h2') as HTMLElement | null)?.focus();
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };
      const showError = () => {
        statusEl.classList.add('error');
        const label = IS_EN ? 'Submission failed. Please email us:' : IS_JA ? '送信できませんでした。メールでご連絡ください：' : '送出失敗，請改用 Email 聯絡：';
        statusEl.innerHTML = `${label} <a href="${buildMailto(data)}">${EMAIL}</a>`;
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      };

      if (!endpoint) {
        // 未設定後端：直接開啟 mailto，並顯示成功狀態
        window.location.href = buildMailto(data);
        showSuccess();
        return;
      }

      try {
        // console 端點只對官網網域回 Access-Control-Allow-Origin，故用預設 cors 模式讀取 JSON 判斷成敗。
        // body 為 URLSearchParams（application/x-www-form-urlencoded）屬簡單請求、不觸發 preflight。
        // 任何失敗（HTTP 非 2xx、ok=false、解析失敗、網路錯誤）都退回 mailto，不再靜默誤報成功。
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new URLSearchParams(data),
        });
        const result = await res.json().catch(() => null);
        if (res.ok && result && result.ok) {
          showSuccess();
        } else {
          showError();
        }
      } catch {
        showError();
      }
    });
  }
</script>
