---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../CTABand.astro';
import FaqSection from '../FaqSection.astro';
import Icon from '../Icon.astro';
import { getLang, localizePath, LOCALE_META } from '../../i18n/utils';
import { useUI, ROUTES, SERVICE_NAV } from '../../i18n/ui';
import { company } from '../../i18n/company';
import { services } from '../../data/services';
import { homeFaq, faqJsonLd } from '../../data/faq';
import { trackStats, milestones, engagements } from '../../data/trackRecord';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);

const c = {
  zh: {
    pageTitle: `企業 AI 導入與城市數位轉型顧問｜${company.brand}`,
    metaDescription:
      'Twouring 遊遊：兩年內得標花蓮、臺東兩件縣府標案（累計 NT$828 萬）、承接日本企業系統開發、為醫院與企業做 AI 導入培訓。從 30 分鐘需求初談開始。',
    heroEyebrow: '企業 AI 導入 × 城市數位轉型 × 臺日跨國交付',
