      'Twouring は設立から2年で、台湾の県政府案件を2件落札し、日本企業のシステム開発パートナーとして継続受託、さらに病院や企業向けのAI実践研修を手がけてきました。台湾での事業展開やAI導入も、同じ方法で検収まで伴走します。',
    proofLabel: '2024–2026 の実績',
    clientsLabel: 'これまでのお取引・ご協力先',
    clients: ['花蓮県政府', '台東県政府', 'ALION株式会社', '大阪市教育委員会（開発協力）', '花蓮慈済病院', '高雄市政府青年局', '沖縄 OIST 国際フォーラム'],
    workEyebrow: '主な実績',
    workTitle: '名前を出せる、出典を確認できる実績',
    workLead: '公共入札の金額は公開調達データに基づきます。企業・海外案件は実際の納品内容でご紹介します。',
    seeAllCases: '実績一覧へ',
    timelineEyebrow: 'この2年の歩み',
    timelineTitle: '設立から越境デリバリーまで（2024–2026）',
    timelineNote: '「TDNA」「KK の役職」と記載したものは、エコシステムまたは代表個人の経歴であり、Twouring の有償顧客ではありません。',
    entryEyebrow: 'サービス',
    entryTitle: 'ご依頼いただけること',
    entryLead: '企業のAI導入・業務自動化・研修から、自治体のデジタルノマド戦略、台湾視察の企画まで。各サービスに課題・解決策・価格の目安を明記しています。',
    entryDesc: {
      city: 'デジタルノマド誘致、海外人材、地方創生を、検収できるKPIに落とし込みます。',
      aiConsulting: '企業AI導入：診断、90日ロードマップ、PMO、ROIの検証まで。',
      venue: 'ノマドフレンドリーな施設・店舗づくりと宿泊のインバウンド対応（Nomad Ready メソッド）。',
      international: '台湾企業・スタートアップ視察、アジア都市交流の企画と運営。',
    },
    ecoEyebrow: '戦略 × 実行',
    ecoTitle: 'ひとつのコンサル判断を、実行チームまで一気通貫で',
    ecoLead: 'Twouring はコンサルティング、プロジェクト統括、品質管理を担い、開発・施設・コミュニティはパートナーが担当。戦略を確実に形にします。',
    eco: [
      { icon: 'compass', name: 'Twouring', role: 'コンサル · 統括 · PMO', desc: '外部コンサルティング、行政受託案件、地域戦略、企業AI導入、プロジェクト管理。' },
      { icon: 'layers', name: '適才科技（Adata）', role: 'デリバリーパートナー · 開発', desc: 'ソフトウェア開発、AIツール構築、システム導入、開発マネジメント。' },
      { icon: 'building', name: '言文字（Emoji Hub）', role: 'デリバリーパートナー · 拠点', desc: '台北駅前の拠点。イベント、ワークショップ、海外コミュニティの受け入れ。' },
      { icon: 'users', name: 'TDNA エコシステム', role: '非営利 · 政策提言', desc: 'デジタルノマドの政策提言と業界連携。Twouring とは役割を明確に分けています。' },
    ],
    methodEyebrow: '進め方',
    methodTitle: 'いきなり提案せず、ヒアリングと診断で最初の一手を見極めます',
    method: [
      { icon: 'target', t: '30分の無料ヒアリング', d: '課題の明確さ、予算と意思決定者を確認します。' },
      { icon: 'doc', t: '有償診断', d: '現状・関係者・リソースを整理し、優先度の高い打ち手を提示します。' },
      { icon: 'route', t: 'コンサル／PMO', d: '診断を実行へ。定例会議、戦略資料、KPIの追跡まで。' },
      { icon: 'chart', t: '導入・年間契約', d: '導入、研修、年間の伴走。成果は公開事例にまとめます。' },
    ],
    whyEyebrow: 'Twouring が選ばれる理由',
    whyTitle: '行政調達・システム開発・海外市場を一度に理解できるチームは多くありません',
    why: [
      { icon: 'shield', t: '入札で選ばれる', d: '4件応札・2件落札。いずれも予算額に近い金額で、企画力と実行力が評価されました。' },
      { icon: 'layers', t: '開発で納品できる', d: '日本のお客様の本番システムを毎月納品。代表の KK は MoBagel 元技術副総裁、AWS 認定ソリューションアーキテクト。' },
      { icon: 'bulb', t: '現場で使えるAI研修', d: '病院・企業・地域講座で、当日中に仕様書・プロトタイプ・再利用できるSOPまで作ります。' },
      { icon: 'globe', t: 'アジアのネットワーク', d: '日本・韓国・東南アジアの都市、スタートアップ、ノマドコミュニティとつながり、日中英の3言語で対応します。' },
    ],
  },
}[lang];

const kindLabel = {
  zh: { gov: '政府', ent: '企業', intl: '國際', eco: 'TDNA／KK 職務' },
  en: { gov: 'Government', ent: 'Enterprise', intl: 'International', eco: 'TDNA / KK’s role' },
  ja: { gov: '行政', ent: '企業', intl: '海外', eco: 'TDNA／KK の役職' },
}[lang];

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: company.brand,
  alternateName: [company.legalName.zh, company.legalName.en],
  url: company.siteUrl,
  description: c.metaDescription,
  inLanguage: LOCALE_META[lang].html,
  publisher: { '@id': company.siteUrl + '/#organization' },
};
const faqItems = homeFaq[lang];
---
<BaseLayout title={c.pageTitle} description={c.metaDescription} path={ROUTES.home} jsonLd={[webPageLd, faqJsonLd(faqItems)]}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">{c.heroEyebrow}</p>
      <h1 set:html={c.heroTitle} />
      <p class="lead hero-lead">{c.heroLead}</p>
      <div class="cluster hero-cta">
        <a class="btn btn--grad btn--lg" href={company.bookingUrl} target="_blank" rel="noopener">{t.cta.primary}</a>
        <a class="btn btn--ghost btn--lg" href={lp(ROUTES.cases)}>{t.cta.viewCases}</a>
      </div>
    </div>
    <div class="container">
      <p class="proof-label">{c.proofLabel}</p>
      <ul class="proof-grid" role="list">
        {trackStats.map((s) => (
          <li class="proof">
            <p class="proof-n">{s.n[lang]}</p>
            <p class="proof-l">{s.l[lang]}</p>
          </li>
        ))}
      </ul>
      <div class="clients">
        <span class="clients-label">{c.clientsLabel}</span>
        <ul class="clients-list" role="list">
          {c.clients.map((x) => (<li>{x}</li>))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 代表實績 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.workEyebrow}</p>
        <h2>{c.workTitle}</h2>
        <p class="lead">{c.workLead}</p>
      </div>
      <div class="work-grid">
        {engagements.map((e, i) => (
          <article class:list={['card', 'work-card', { 'work-card--wide': i < 2 }]}>
            <span class="tag">{e.tag[lang]}</span>
            <p class="work-client">{e.client[lang]}</p>
            <h3>{e.title[lang]}</h3>
            <p class="work-desc">{e.desc[lang]}</p>
            <ul class="work-points" role="list">
              {e.points[lang].map((p) => (<li><Icon name="check" size={16} /> {p}</li>))}
            </ul>
          </article>
        ))}
      </div>
      <div class="cases-all">
        <a class="btn btn--ghost" href={lp(ROUTES.cases)}>{c.seeAllCases} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 兩年軌跡 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.timelineEyebrow}</p>
        <h2>{c.timelineTitle}</h2>
      </div>
      <ol class="timeline" role="list">
        {milestones.map((m) => (
          <li class:list={['tl-item', `tl-item--${m.kind}`]}>
            <p class="tl-date">{m.date}<span class="tl-kind">{kindLabel[m.kind]}</span></p>
            <h3>{m.title[lang]}</h3>
            <p>{m.desc[lang]}</p>
          </li>
        ))}
      </ol>
      <p class="tl-note">{c.timelineNote}</p>
    </div>
  </section>

  <!-- 服務入口 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.entryEyebrow}</p>
        <h2>{c.entryTitle}</h2>
        <p class="lead">{c.entryLead}</p>
      </div>
      <div class="grid grid--2 entry-grid">
        {SERVICE_NAV.map((s) => (
          <a class="card card--link entry-card" href={lp(services[s.key].path)}>
            <span class="entry-icon"><Icon name={services[s.key].icon} size={26} /></span>
            <h3>{t.serviceNav[s.key]}</h3>
            <p>{c.entryDesc[s.key]}</p>
            <span class="entry-go">{t.cta.viewService} <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 為什麼是遊遊 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.whyEyebrow}</p>
        <h2>{c.whyTitle}</h2>
      </div>
      <div class="grid grid--4 why-grid">
        {c.why.map((w) => (
          <div class="why-card">
            <span class="why-icon"><Icon name={w.icon} size={24} /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 策略 × 執行 生態系 -->
  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--light">{c.ecoEyebrow}</p>
