    },
    ecoEyebrow: 'Strategy × delivery',
    ecoTitle: 'One advisory judgment, backed by a full delivery ecosystem',
    ecoLead: 'Twouring owns advisory, project integration and quality control; technology, venues and community are handled by partners so strategy actually ships.',
    eco: [
      { icon: 'compass', name: 'Twouring', role: 'Advisory · integration · PMO', desc: 'External advisory, awarded government projects, city strategy, enterprise AI and project management.' },
      { icon: 'layers', name: 'Adata', role: 'Delivery partner · engineering', desc: 'Software development, AI tooling, system rollout and engineering management.' },
      { icon: 'building', name: 'Yan-Wen-Zi', role: 'Delivery partner · venue', desc: 'A venue opposite Taipei Main Station for events, workshops and hosting international communities.' },
      { icon: 'users', name: 'TDNA ecosystem', role: 'Non-profit · not a paid client', desc: 'Digital-nomad advocacy and industry links — roles clearly split from Twouring.' },
    ],
    methodEyebrow: 'Methodology',
    methodTitle: 'We don’t pitch first — discovery and diagnostics find the next step',
    method: [
      { icon: 'target', t: '30-min discovery', d: 'Confirm the problem, budget and decision-maker (free).' },
      { icon: 'doc', t: 'Paid diagnostic', d: 'Map status quo, stakeholders and resources into top priorities.' },
      { icon: 'route', t: 'Advisory / PMO', d: 'Turn diagnosis into delivery: cadence, strategy docs and KPIs.' },
      { icon: 'chart', t: 'Rollout & annual', d: 'Rollout, training and annual work — turned into public cases.' },
    ],
    whyEyebrow: 'Why Twouring',
    whyTitle: 'Few teams understand public procurement, engineering delivery and international markets at once',
    why: [
      { icon: 'shield', t: 'We win tenders', d: '2 of 4 bids won, both awarded at close to full budget — evaluated on plan quality and delivery capability.' },
      { icon: 'layers', t: 'We ship software', d: 'Production systems delivered monthly to a Japanese client; founder KK is a former VP Engineering at MoBagel and an AWS-certified architect.' },
      { icon: 'bulb', t: 'AI training that sticks', d: 'Hospitals, companies and local talks leave with a spec, a prototype or a reusable SOP — on the day.' },
      { icon: 'globe', t: 'A real Asia network', d: 'Cities, startups and nomad communities across Japan, Korea and SEA; we work in Chinese, English and Japanese.' },
    ],
  },
  ja: {
    pageTitle: `企業AI導入と都市・地域DXのコンサルティング｜${company.brand}`,
    metaDescription:
      'Twouring（遊遊股份有限公司）：設立2年で花蓮県・台東県の公共入札を2件落札（累計NT$828万）。日本企業のシステム開発を継続受託し、病院・企業向けAI実践研修も提供。台湾での事業展開・視察・AI導入のご相談は30分の無料ヒアリングから。',
    heroEyebrow: '企業AI導入 × 地域DX × 台湾・日本の越境デリバリー',
