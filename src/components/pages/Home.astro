      { icon: 'doc', t: '有償診断', d: '現状・関係者・リソースを整理し、優先度の高い打ち手を提示します。' },
      { icon: 'route', t: 'コンサル／PMO', d: '診断を実行へ。定例会議、戦略資料、KPIの追跡まで。' },
      { icon: 'chart', t: '導入・年間契約', d: '導入、研修、年間契約での支援。成果は公開事例にまとめます。' },
    ],
    whyEyebrow: 'Twouring が選ばれる理由',
    whyTitle: '行政入札、システム開発、AI研修、海外との連携を実務で経験しています',
    why: [
      { icon: 'shield', t: '行政入札', d: '4件応札・2件落札。いずれも予算額に近い金額で落札しました。' },
      { icon: 'layers', t: 'システム開発', d: '日本のお客様の本番システムを毎月納品。代表の KK は MoBagel 元技術副総裁、AWS 認定ソリューションアーキテクト。' },
      { icon: 'bulb', t: 'AI研修', d: '病院・企業・地域講座で、当日中に仕様書・プロトタイプ・再利用できるSOPまで作ります。' },
      { icon: 'globe', t: '海外ネットワーク', d: '日本・韓国・東南アジアの都市、スタートアップ、ノマドコミュニティとつながり、日中英の3言語で対応します。' },
    ],
    kkEyebrow: 'リードコンサルタント',
    kkTitle: 'すべての案件を、まず徐愷（KK）が見極めます',
    kkLead: 'エンジニア出身で技術副総裁を経て起業、公共入札の落札経験もあります。案件を見るときの問いは二つだけ。やる価値があるか、検収できるか。',
    kkFacts: [
      '国立台湾大学 資訊工程学科卒、ソフトウェア開発歴15年',
      'MoBagel 元技術副総裁（VP of Engineering、2014–2018）。2018年に匠說を共同創業し CTO、2020年に適才科技を設立',
      'AWS 認定ソリューションアーキテクト',
      'PyCon Taiwan、PyCon JP 2019（東京・英語）登壇。中華電信・資策会の社内研修講師',
      '台湾デジタルノマド協会 理事長、国家発展委員会「遊牧臺灣」事務局 執行長',
      'Microsoft GCR Startup Hackfest 優勝、Salesforce 100万ドル Hackathon 世界6位',
    ],
    kkQuote: 'まずシステムを買うのではなく、いちばん困っている業務をはっきりさせること。既存のツールで解決できるなら、開発は勧めません。',
    kkQuoteBy: 'KK、Twouring 代表',
    kkCta: 'KK の経歴を見る',
    kkBook: '30分の相談を予約',
  },
}[lang];

const serviceGroups = {
  zh: {
    enterprise: { title: '企業解決方案', lead: '從 AI 導入、流程自動化、內訓到系統整合與工作制度。' },
    government: { title: '政府與城市', lead: '把人才、場域與政策目標做成可驗收的城市策略。' },
    place: { title: '場域與國際', lead: '讓商家、旅宿與跨國交流有清楚的接待與合作入口。' },
  },
  en: {
    enterprise: { title: 'Enterprise solutions', lead: 'AI adoption, automation, training, systems and ways of working.' },
    government: { title: 'Government & cities', lead: 'Turn talent, venues and policy goals into an auditable city strategy.' },
    place: { title: 'Venues & international', lead: 'Clear hosting and collaboration paths for venues and cross-border exchange.' },
  },
  ja: {
    enterprise: { title: '企業向けソリューション', lead: 'AI導入、業務自動化、研修、システム、働き方まで。' },
    government: { title: '自治体・地域', lead: '人材、拠点、政策目標を検証可能な地域戦略にします。' },
    place: { title: '拠点・国際交流', lead: '店舗・宿泊施設と国際交流に、明確な受け入れと連携の入口を。' },
  },
}[lang];

const kindLabel = {
  zh: { gov: '政府', ent: '企業', intl: '國際', eco: 'TDNA／KK 職務', kk: 'KK 經歷' },
  en: { gov: 'Government', ent: 'Enterprise', intl: 'International', eco: 'TDNA / KK’s role', kk: 'KK before Twouring' },
  ja: { gov: '行政', ent: '企業', intl: '海外', eco: 'TDNA／KK の役職', kk: '設立前の KK' },
}[lang];

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: company.brand,
  alternateName: [company.legalName.zh, company.legalName.en],
  url: company.siteUrl,
  description: c.metaDescription,
  inLanguage: LOCALE_META[lang].html,
  publisher: { '@id': company.siteUrl + '/#organization' },
};
const faqItems = homeFaq[lang];
import WebinarPromo from '../WebinarPromo.astro';
---
<BaseLayout title={c.pageTitle} description={c.metaDescription} path={ROUTES.home} jsonLd={[webPageLd, faqJsonLd(faqItems)]}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">{c.heroEyebrow}</p>
      <h1 set:html={c.heroTitle} />
      <p class="lead hero-lead">{c.heroLead}</p>
      <div class="cluster hero-cta">
        <a class="btn btn--grad btn--lg" href={company.bookingUrl} target="_blank" rel="noopener">{t.cta.primary}</a>
        <a class="btn btn--ghost btn--lg" href={lp(ROUTES.cases)}>{t.cta.viewCases}</a>
      </div>
      <ProgramsSection variant="strip" />
    </div>
    <div class="container">
      <p class="proof-label">{c.proofLabel}</p>
      <ul class="proof-grid" role="list">
        {trackStats.map((s) => (
          <li class="proof">
            <p class="proof-n">{s.n[lang]}</p>
            <p class="proof-l">{s.l[lang]}</p>
          </li>
        ))}
      </ul>
      <div class="clients">
        <span class="clients-label">{c.clientsLabel}</span>
        <ul class="clients-list" role="list">
          {c.clients.map((x) => (<li>{x}</li>))}
        </ul>
      </div>
    </div>
  </section>

  <ProgramsSection />

  {lang === 'zh' && (
    <section class="section section--tight">
      <div class="container"><WebinarPromo variant="band" /></div>
    </section>
  )}

  <!-- 代表實績 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.workEyebrow}</p>
        <h2>{c.workTitle}</h2>
        <p class="lead">{c.workLead}</p>
      </div>
      <div class="work-grid">
        {engagements.map((e, i) => (
          <article class:list={['card', 'work-card', { 'work-card--wide': i < 2 }]}>
            <span class="tag">{e.tag[lang]}</span>
            <p class="work-client">{e.client[lang]}</p>
            <h3>{e.title[lang]}</h3>
            <p class="work-desc">{e.desc[lang]}</p>
            <ul class="work-points" role="list">
              {e.points[lang].map((p) => (<li><Icon name="check" size={16} /> {p}</li>))}
            </ul>
          </article>
        ))}
      </div>
      <div class="cases-all">
        <a class="btn btn--ghost" href={lp(ROUTES.cases)}>{c.seeAllCases} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 主導顧問 KK -->
  <section class="section">
    <div class="container kk-wrap">
      <div class="kk-aside">
        <img class="kk-photo" src="/kk-portrait.jpg" alt={{ zh: '徐愷（KK）肖像照', en: 'Portrait of Kai Hsu (KK)', ja: '徐愷（KK）のポートレート' }[lang]} width="640" height="965" loading="lazy" />
      </div>
      <div class="kk-body">
        <p class="eyebrow">{c.kkEyebrow}</p>
        <h2 set:html={c.kkTitle} />
        <p class="lead">{c.kkLead}</p>
        <ul class="kk-facts" role="list">
          {c.kkFacts.map((f) => (<li><Icon name="check" size={18} /> <span>{f}</span></li>))}
        </ul>
        <blockquote class="kk-quote">
          <p>「{c.kkQuote}」</p>
          <cite>— {c.kkQuoteBy}</cite>
        </blockquote>
        <div class="cluster kk-cta">
          <a class="btn btn--primary" href={company.bookingUrl} target="_blank" rel="noopener">{c.kkBook}</a>
          <a class="btn btn--ghost" href={lp(ROUTES.about)}>{c.kkCta} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 兩年軌跡 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.timelineEyebrow}</p>
        <h2>{c.timelineTitle}</h2>
      </div>
      <ol class="timeline" role="list">
        {[...milestones].reverse().map((m) => (
          <li class:list={['tl-item', `tl-item--${m.kind}`]}>
            <p class="tl-date">{m.date}<span class="tl-kind">{kindLabel[m.kind]}</span></p>
            <h3>{m.title[lang]}</h3>
            <p>{m.desc[lang]}</p>
          </li>
        ))}
      </ol>
      <p class="tl-note">{c.timelineNote}</p>
    </div>
  </section>

  <!-- 服務入口 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.entryEyebrow}</p>
        <h2>{c.entryTitle}</h2>
        <p class="lead">{c.entryLead}</p>
      </div>
      <div class="service-groups">
        {SERVICE_GROUPS.map((group) => (
          <div class="service-group">
            <div class="service-group-head">
              <h3>{serviceGroups[group.id].title}</h3>
              <p>{serviceGroups[group.id].lead}</p>
            </div>
            <div class="grid grid--3 entry-grid">
              {group.keys.map((key) => (
                <a class="card card--link entry-card" href={lp(services[key].path)}>
                  <span class="entry-icon"><Icon name={services[key].icon} size={26} /></span>
                  <h4>{t.serviceNav[key]}</h4>
                  <p>{c.entryDesc[key]}</p>
                  <span class="entry-go">{t.cta.viewService} <Icon name="arrow" size={18} /></span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 為什麼是遊遊 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.whyEyebrow}</p>
        <h2>{c.whyTitle}</h2>
      </div>
      <div class="grid grid--4 why-grid">
        {c.why.map((w) => (
          <div class="why-card">
            <span class="why-icon"><Icon name={w.icon} size={24} /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 策略 × 執行 生態系 -->
  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--light">{c.ecoEyebrow}</p>
        <h2>{c.ecoTitle}</h2>
        <p class="lead lead--light">{c.ecoLead}</p>
      </div>
      <div class="grid grid--4 eco-grid">
        {c.eco.map((e) => (
          <div class="eco-card">
            <span class="eco-icon"><Icon name={e.icon} size={24} /></span>
            <h3>{e.name}</h3>
            <p class="eco-role">{e.role}</p>
            <p class="eco-desc">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 方法論 -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">{c.methodEyebrow}</p>
        <h2>{c.methodTitle}</h2>
      </div>
      <ol class="method-steps" role="list">
        {c.method.map((m, i) => (
          <li class="method-step">
            <span class="method-num">{i + 1}</span>
            <span class="method-ic"><Icon name={m.icon} size={22} /></span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FaqSection
    title={{ zh: '找顧問前，客戶最常問的問題', en: 'What clients ask before hiring us', ja: 'ご相談前によくいただくご質問' }[lang]}
    items={faqItems}
  />

  <CTABand />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(3.5rem, 9vw, 7rem); }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(1100px 520px at 78% -8%, rgba(255,177,153,0.42), transparent 60%),
      radial-gradient(820px 460px at 12% 0%, rgba(255,8,68,0.12), transparent 55%),
      #fff;
  }
  .hero-inner { max-width: var(--container); }
  .hero-eyebrow { letter-spacing: 0.14em; }
  .hero h1 { font-size: clamp(2.1rem, 1.5rem + 3.2vw, 3.8rem); max-width: 22ch; }
  .hero-lead { margin-top: 1.4rem; max-width: 56ch; font-size: var(--fs-500); }
  .hero-cta { margin-top: 2rem; }
  .trust { margin-top: 3rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .trust-label { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-faint); font-weight: 700; }
  .trust-list { display: grid; gap: 0.55rem; }
  .trust-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.8rem; align-items: baseline; font-size: 0.94rem; }
  .trust-k { font-family: var(--font-head); font-weight: 700; color: var(--c-ink); }
  .trust-v { color: var(--c-muted); }
  @media (max-width: 560px) {
    .trust-list li { grid-template-columns: 1fr; gap: 0.15rem; }
  }

  /* 主導顧問 KK */
  .kk-wrap { display: grid; grid-template-columns: 300px 1fr; gap: 2.5rem; align-items: center; }
  .kk-photo { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .kk-body h2 { margin-top: 0.6rem; max-width: 24ch; }
  .kk-body .lead { margin-top: 0.8rem; max-width: 56ch; }
  .kk-facts { margin-top: 1.2rem; display: grid; gap: 0.5rem; }
  .kk-facts li { display: flex; gap: 0.5rem; align-items: flex-start; color: var(--c-ink); }
  .kk-facts :global(svg) { color: var(--c-accent-strong); flex-shrink: 0; margin-top: 4px; }
  .kk-quote { margin-top: 1.4rem; padding: 1.1rem 1.4rem; border-left: 3px solid var(--c-accent); background: var(--c-surface-warm); border-radius: 0 var(--radius) var(--radius) 0; max-width: 60ch; }
  .kk-quote p { font-family: var(--font-head); font-weight: 700; font-size: var(--fs-500); color: var(--c-ink-strong); line-height: 1.5; }
  .kk-quote cite { display: block; margin-top: 0.5rem; font-style: normal; color: var(--c-muted); font-size: 0.9rem; }
  .kk-cta { margin-top: 1.4rem; }
  @media (max-width: 760px) {
    .kk-wrap { grid-template-columns: 1fr; }
    .kk-photo { max-width: 240px; }
  }

  /* 服務入口 */
  .service-groups { display: grid; gap: 2.4rem; }
  .service-group-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 1rem; }
  .service-group-head h3 { font-size: var(--fs-600); }
  .service-group-head p { color: var(--c-muted); }
  .entry-grid { gap: 1.2rem; }
  .entry-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .entry-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--radius); background: var(--grad-soft); color: var(--c-accent-strong); margin-bottom: 0.4rem; }
  .entry-card h4 { font-size: var(--fs-600); }
  .entry-card p { color: var(--c-muted); }
  .entry-go { margin-top: auto; padding-top: 0.6rem; display: inline-flex; align-items: center; gap: 0.4em; color: var(--c-accent-strong); font-family: var(--font-head); font-weight: 700; }
  .entry-card:hover .entry-go :global(svg) { transform: translateX(4px); transition: transform 0.2s var(--ease); }

  /* eco */
  .eyebrow--light { color: var(--c-accent-2); }
  .lead--light { color: #c4c9cf; }
  .eco-grid { gap: 1.2rem; }
  .eco-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); padding: 1.5rem; }
  .eco-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius); background: var(--grad-brand); color: #fff; margin-bottom: 1rem; }
  .eco-card h3 { color: #fff; font-size: var(--fs-500); }
  .eco-role { color: var(--c-accent-2); font-size: 0.85rem; font-weight: 600; margin: 0.3rem 0 0.6rem; font-family: var(--font-head); }
  .eco-desc { color: #aeb3ba; font-size: 0.92rem; }

  /* 方法論 */
  .method-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .method-step { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); padding: 1.5rem; position: relative; }
  .method-num { position: absolute; top: 1.2rem; right: 1.4rem; font-family: var(--font-head); font-weight: 800; font-size: 1.6rem; color: var(--c-accent-2); }
  .method-ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: var(--c-surface-warm); color: var(--c-accent-strong); margin-bottom: 1rem; }
  .method-step h3 { font-size: var(--fs-500); }
  .method-step p { color: var(--c-muted); font-size: 0.94rem; margin-top: 0.4rem; }

  /* why */
  .why-grid { gap: 1.2rem; }
  .why-card { padding: 0.4rem; }
  .why-icon { display: grid; place-items: center; width: 50px; height: 50px; border-radius: var(--radius); background: var(--grad-soft); color: var(--c-accent-strong); margin-bottom: 1rem; }
  .why-card h3 { font-size: var(--fs-500); }
  .why-card p { color: var(--c-muted); margin-top: 0.4rem; }

  /* stats */
  .stat-grid { gap: 1.2rem; }
  .stat { text-align: center; padding: 1rem; }
  .stat-n { font-family: var(--font-head); font-weight: 800; font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem); background: var(--grad-text); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .stat-l { color: var(--c-muted); font-size: 0.92rem; margin-top: 0.4rem; }

  /* cases */
  .case-teaser { display: flex; flex-direction: column; gap: 0.7rem; align-items: flex-start; }
  .case-teaser h3 { font-size: var(--fs-500); }
  .case-teaser p { color: var(--c-muted); }
  .cases-all { margin-top: 1.8rem; }


  /* proof */
  .proof-label { margin-top: clamp(2.4rem, 5vw, 3.4rem); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-faint); font-weight: 700; }
  .proof-grid { margin-top: 0.8rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .proof { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); padding: 1.2rem 1.3rem; }
  .proof-n { font-family: var(--font-head); font-weight: 800; font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.3rem); line-height: 1.1; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .proof-l { color: var(--c-muted); font-size: 0.9rem; margin-top: 0.45rem; line-height: 1.5; }
  .clients { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: baseline; }
  .clients-label { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-faint); font-weight: 700; }
  .clients-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .clients-list li { font-family: var(--font-head); font-weight: 700; font-size: 0.9rem; color: var(--c-ink-strong); background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-pill); padding: 0.35em 0.9em; }

  /* work */
  .work-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.2rem; }
  .work-card { grid-column: span 2; display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; background: #fff; }
  .work-card--wide { grid-column: span 3; }
  .work-client { font-family: var(--font-head); font-weight: 700; color: var(--c-accent-strong); font-size: 0.92rem; margin-top: 0.2rem; }
  .work-card h3 { font-size: var(--fs-500); }
  .work-desc { color: var(--c-muted); }
  .work-points { display: grid; gap: 0.35rem; margin-top: 0.3rem; }
  .work-points li { display: flex; gap: 0.45rem; align-items: flex-start; font-size: 0.92rem; color: var(--c-ink); }
  .work-points :global(svg) { color: var(--c-accent-strong); flex-shrink: 0; margin-top: 4px; }

  /* timeline */
  .timeline { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .tl-item { border-left: 3px solid var(--c-accent-2); padding: 0.4rem 0 0.4rem 1rem; }
  .tl-item--gov { border-left-color: var(--c-accent-strong); }
