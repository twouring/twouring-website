      { icon: 'route', t: '顧問 / PMO', d: '把診斷轉成執行：例會、策略文件與 KPI 追蹤。' },
      { icon: 'chart', t: '導入與年度', d: '專案導入、培訓與年度合作，並轉成可公開案例。' },
    ],
    whyEyebrow: '為什麼是遊遊',
    whyTitle: '同時懂政府採購、工程交付與國際市場的團隊不多',
    why: [
      { icon: 'shield', t: '標案打得下來', d: '投標 4 案得 2 案，兩案皆以近乎預算全額決標，評選看的是企劃與執行力。' },
      { icon: 'layers', t: '工程交付得出來', d: '日本客戶的正式系統按月交付；負責人 KK 曾任 MoBagel 技術副總、AWS 認證架構師。' },
      { icon: 'bulb', t: 'AI 教得會、用得上', d: '醫院、企業與地方講座，現場就做出規格、原型或可重複使用的 SOP。' },
      { icon: 'globe', t: '國際網絡接得上', d: '日本、韓國、東南亞的城市、新創與遊牧社群；中英日三語溝通。' },
    ],
  },
  en: {
    pageTitle: `Enterprise AI & city digital-transformation advisory｜${company.brand}`,
    metaDescription:
      'Twouring: two county-government tenders won in Hualien and Taitung (NT$8.28M combined), ongoing engineering for a Japanese company, and hands-on AI training for hospitals and businesses. Start with a 30-minute discovery call.',
    heroEyebrow: 'Enterprise AI × city transformation × Taiwan–Japan delivery',
    heroTitle: 'Government tenders, Japanese software projects, hospital AI training — <span class="text-grad keep">all delivered</span>',
    heroLead:
      'In two years Twouring has won two county-government contracts, become a long-term engineering partner to a Japanese company, and designed hands-on AI training for hospitals and businesses. We bring the same method to your project — through to sign-off.',
    proofLabel: 'Track record 2024–2026',
    clientsLabel: 'Organisations we have worked with',
    clients: ['Hualien County Government', 'Taitung County Government', 'ALION Inc. (Japan)', 'Osaka City Board of Education (co-development)', 'Hualien Tzu Chi Hospital', 'Kaohsiung City Youth Bureau', 'OIST forum, Okinawa'],
    workEyebrow: 'Selected work',
    workTitle: 'Named projects you can verify',
    workLead: 'Tender values come from public procurement records; enterprise and overseas work is described by what we actually delivered.',
    seeAllCases: 'View all work',
    timelineEyebrow: 'Two years in',
    timelineTitle: 'From founding to cross-border delivery, 2024–2026',
