---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CTABand from '../CTABand.astro';
import { getLang, localizePath } from '../../i18n/utils';
import { useUI, ROUTES } from '../../i18n/ui';
import { company } from '../../i18n/company';
import { insights, type InsightSlug } from '../../data/insights';

interface Props { slug: InsightSlug; }
const { slug } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);
const article = insights[slug];
const d = article[lang];
const path = article.path;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'zh' ? '首頁' : 'Home', item: company.siteUrl + lp(ROUTES.home) },
    { '@type': 'ListItem', position: 2, name: t.nav.insights, item: company.siteUrl + lp(ROUTES.insights) },
    { '@type': 'ListItem', position: 3, name: d.title, item: company.siteUrl + lp(path) },
  ],
};

const authorName = lang === 'zh' ? '徐愷（KK）' : 'Kai Hsu (KK)';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: article.published,
  dateModified: article.updated,
  inLanguage: lang === 'zh' ? 'zh-Hant-TW' : 'en',
  author: {
    '@type': 'Person',
    '@id': company.siteUrl + '/#kk',
    name: authorName,
    url: company.linkedinKK,
    jobTitle: lang === 'zh' ? '遊遊股份有限公司負責人／主導顧問' : 'Founder & lead advisor, Twouring Co., Ltd.',
    worksFor: { '@id': company.siteUrl + '/#organization' },
  },
  publisher: { '@id': company.siteUrl + '/#organization' },
  mainEntityOfPage: company.siteUrl + lp(path),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.article-lead', '.prose .block:first-of-type p:first-of-type'],
  },
};
---
<BaseLayout title={d.title} description={d.description} path={path} jsonLd={[breadcrumbLd, articleLd]}>
  <PageHero
    eyebrow={d.eyebrow}
    title={d.title}
    lead={d.lead}
    crumbs={[{ label: t.nav.insights, path: ROUTES.insights }, { label: d.eyebrow }]}
  >
    <p class="meta">
      <span>{lang === 'zh' ? '作者' : 'Author'}：{authorName}</span>
      <span>{t.common.lastUpdated}：{article.updated}</span>
    </p>
  </PageHero>

  <article class="section">
    <div class="container prose">
      <p class="article-lead">{d.lead}</p>
      {d.sections.map((s) => (
        <section class="block">
          <h2>{s.heading}</h2>
          {s.paras.map((p) => (<p>{p}</p>))}
        </section>
      ))}
      <p class="back"><a href={lp(ROUTES.insights)}>{lang === 'zh' ? '← 全部洞察' : '← All insights'}</a></p>
    </div>
  </article>

  <CTABand />
</BaseLayout>

<style>
  .meta { margin-top: 1rem; color: var(--c-faint); font-size: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .prose { max-width: 720px; }
  .article-lead { font-size: var(--fs-500); color: var(--c-ink); margin-bottom: 1.8rem; line-height: 1.65; }
  .block { margin-bottom: 2.2rem; }
  .block h2 { font-size: var(--fs-500); margin-bottom: 0.8rem; }
  .block p { color: var(--c-muted); margin-bottom: 0.8rem; line-height: 1.7; }
  .back { margin-top: 2rem; }
  .back a { color: var(--c-accent-strong); font-weight: 700; }
</style>
