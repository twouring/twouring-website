---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CTABand from '../CTABand.astro';
import Icon from '../Icon.astro';
import { getLang, localizePath } from '../../i18n/utils';
import { useUI, ROUTES, SERVICE_GROUPS } from '../../i18n/ui';
import { services } from '../../data/services';

const lang = getLang(Astro.currentLocale);
const t = useUI(lang);
const lp = (p: string) => localizePath(p, lang);

const c = {
  zh: {
    eyebrow: '服務總覽',
    title: '企業 AI 導入、城市策略與國際參訪：服務項目與合作方式',
    lead: '以下依客戶類型列出遊遊提供的服務。每項服務都從 30 分鐘需求初談開始，確認需求後再進入付費診斷、顧問／PMO 或導入專案。',
    metaDescription:
      '遊遊顧問服務：企業 AI 導入、AI 內訓、流程自動化、ERP／CRM 系統開發與整合、遠距工作制度、數位遊牧城市策略、友善場域與國際企業參訪。皆以 30 分鐘需求初談為入口。',
    aiTitle: '企業：AI、內訓、系統與工作制度',
    aiLead: '企業最常問的三件事：AI 從哪裡開始、團隊怎麼教才會用、既有系統怎麼整合。',
    governmentTitle: '政府與城市：人才、場域與政策的策略規劃',
    governmentLead: '數位遊牧城市策略、場域盤點與年度 PMO，讓單次活動結束後仍有可追蹤、可驗收的指標。',
    placeTitle: '場域與國際：接待能力與跨國合作',
    placeLead: '從友善場域與旅宿國際化，到亞洲城市交流與企業參訪。',
    ladderTitle: '合作怎麼開始',
    ladderLead: '所有服務線都依同樣的階段進行。你可以只做第一階段，看過結果再決定是否繼續。',
    ladder: [
      { t: '洞察文章 / 講座', d: '官網洞察文章、公開講座與說明會。開會前可以先了解我們的做法。' },
      { t: '30 分鐘需求初談', d: '免費。確認問題是否清楚、有無預算與決策者，給你初步方向。' },
      { t: '付費診斷', d: 'NTD 30,000–200,000，依單位類型與複雜度；交付優先順序、時程與預算建議。' },
      { t: '3 個月顧問 / PMO', d: 'NTD 80,000–250,000／月，把診斷結果轉成執行與 KPI 追蹤。' },
      { t: '導入專案 / 年度合作', d: 'NTD 300,000–3,000,000＋，依規模與是否含系統開發、活動、國際對接。' },
    ],
    grantTitle: '補助與標案策略顧問',
    grantDesc: '遊遊也提供補助／標案的可行性診斷（NTD 50,000）、計畫書策略（NTD 150,000 起）與 PMO（NTD 80,000／月）。服務範圍是策略、計畫設計與執行管理，不承接低價代寫。成功分潤 5–12% 一律搭配基本費，不接無基本費的純抽成案。',
    seeService: '查看服務',
  },
  en: {
    eyebrow: 'All services',
    title: 'Enterprise AI, city strategy and international visits: services and how we engage',
    lead: 'Below are the services Twouring offers, grouped by client type. Each one starts with a 30-minute discovery call; after that comes a paid diagnostic, advisory/PMO or a rollout project.',
    metaDescription:
      'Twouring advisory: enterprise AI adoption, AI training, workflow automation, ERP/CRM systems integration, remote-work systems, digital-nomad city strategy, friendly venues and Taiwan business delegations. Every engagement starts with a 30-minute discovery call.',
    aiTitle: 'Enterprise: AI, training, systems and work policy',
    aiLead: 'The three questions companies ask most: where to start with AI, how to train a team so it sticks, and how to integrate the systems you already have.',
    governmentTitle: 'Government & cities: strategy for talent, venues and policy',
    governmentLead: 'Digital-nomad city strategy, venue mapping and annual PMO, with indicators you can track and audit after a one-off event ends.',
    placeTitle: 'Venues & international: hosting capacity and cross-border partnerships',
    placeLead: 'From venue and hospitality internationalisation to Asia city exchange and corporate visits.',
    ladderTitle: 'How an engagement starts',
    ladderLead: 'Every service line follows the same stages. You can stop after the first one, review the result, then decide whether to continue.',
    ladder: [
      { t: 'Insights / talks', d: 'Website articles, public talks and briefings. You can see how we work before any meeting.' },
      { t: '30-min discovery', d: 'Free. We confirm the problem is clear, that there is budget and a decision-maker, and give an initial direction.' },
      { t: 'Paid diagnostic', d: 'NTD 30,000–200,000 by organisation type and complexity; you receive priorities, timeline and budget advice.' },
      { t: '3-month advisory / PMO', d: 'NTD 80,000–250,000/mo, turning the diagnosis into delivery and KPI tracking.' },
      { t: 'Rollout / annual', d: 'NTD 300,000–3,000,000+, by scale and whether software, events or exchange are included.' },
    ],
    grantTitle: 'Grants & public-tender strategy',
    grantDesc: 'Twouring also offers grant/tender feasibility diagnostics (NTD 50,000), proposal strategy (from NTD 150,000) and PMO (NTD 80,000/mo). Our scope is strategy, plan design and delivery management; we do not take low-cost ghost-writing. A 5–12% success fee always comes with a base fee, and we do not take success-fee-only work.',
    seeService: 'View service',
  },
  ja: {
    eyebrow: 'サービス一覧',
    title: '企業のAI導入、地域戦略、国際視察：サービス内容と進め方',
    lead: 'Twouring が提供するサービスを、お客様の種別ごとに掲載しています。どのサービスも30分の無料ヒアリングから始まり、有償診断、コンサルティング、PMO、導入へと段階的に進みます。',
    metaDescription:
      'Twouring のサービス：企業AI導入支援、AI研修、業務自動化、ERP／CRMシステム開発・統合、リモートワーク制度、デジタルノマド誘致戦略、ノマドフレンドリーな施設づくり、台湾視察の企画。すべて30分の無料ヒアリングから。',
    aiTitle: '企業向け：AI・研修・システム・働き方',
    aiLead: '企業からもっとも多いご質問は三つ。AIをどこから始めるか、研修をどう定着させるか、既存システムをどう統合するか。',
    governmentTitle: '自治体・地域：人材、拠点、政策の戦略設計',
    governmentLead: 'デジタルノマドの地域戦略、拠点の棚卸し、年間PMO。単発のイベントの後も追跡・検証できる指標を設定します。',
    placeTitle: '拠点・国際交流：受け入れ体制と越境協働',
    placeLead: 'ノマドフレンドリーな拠点・宿泊施設の国際化から、アジア都市交流・企業視察まで。',
    ladderTitle: 'ご相談の進め方',
    ladderLead: 'どのサービスも同じステップで進めます。最初の一歩だけ試し、結果を見てから次に進むかをご判断いただけます。',
    ladder: [
      { t: 'インサイト記事・講演', d: '記事、公開講演、説明会。打ち合わせの前に、私たちの進め方をご確認いただけます。' },
      { t: '30分の無料ヒアリング', d: '無料。課題の明確さ、予算と意思決定者の有無を確認し、初期の方向性をお伝えします。' },
      { t: '有償診断', d: 'NTD 30,000–200,000。組織の種別と複雑さに応じて設定し、優先順位・スケジュール・予算案を納品します。' },
      { t: '3か月のコンサルティング／PMO', d: 'NTD 80,000–250,000／月。診断結果を実行とKPI管理に移します。' },
      { t: '導入プロジェクト・年間契約', d: 'NTD 300,000–3,000,000＋。規模や、開発・イベント・国際連携の有無で変動します。' },
    ],
    grantTitle: '補助金・公共入札の戦略支援',
    grantDesc: '補助金・入札の実現可能性診断（NTD 50,000）、計画書の戦略設計（NTD 150,000〜）、PMO（NTD 80,000／月）も提供しています。対応範囲は戦略、計画設計、実行管理で、安価な代筆はお受けしていません。成功報酬（5–12%）は必ず基本料金と組み合わせます。',
    seeService: '詳しく見る',
  },
}[lang];

const groupContent = {
  enterprise: { title: c.aiTitle, lead: c.aiLead, surface: false },
  government: { title: c.governmentTitle, lead: c.governmentLead, surface: true },
  place: { title: c.placeTitle, lead: c.placeLead, surface: false },
};
---
<BaseLayout title={{ zh: '服務', en: 'Services', ja: 'サービス' }[lang]} description={c.metaDescription} path={ROUTES.services}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: t.nav.services }]} />

  {SERVICE_GROUPS.map((group) => (
    <section class:list={['section', { 'section--surface': groupContent[group.id].surface }]}>
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">{groupContent[group.id].title}</p>
          <h2>{groupContent[group.id].lead}</h2>
        </div>
        <div class="grid grid--3 svc-grid">
          {group.keys.map((key) => {
            const d = services[key][lang];
            return (
              <article class="card svc-card">
                <span class="svc-icon"><Icon name={services[key].icon} size={26} /></span>
                <p class="svc-eyebrow">{d.eyebrow}</p>
                <h3>{d.title}</h3>
                <p class="svc-lead">{d.lead}</p>
                <ul class="svc-highlights" role="list">
                  {d.highlights.map((h) => (<li><Icon name="check" size={16} /> {h}</li>))}
                </ul>
                <a class="btn btn--ghost svc-btn" href={lp(services[key].path)}>{c.seeService} <Icon name="arrow" size={18} /></a>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <div class="section-head center"><p class="eyebrow">{c.ladderTitle}</p><h2>{c.ladderLead}</h2></div>
      <ol class="ladder" role="list">
        {c.ladder.map((step, i) => (
          <li class="ladder-step">
            <span class="ladder-num">{i + 1}</span>
            <div>
              <h3>{step.t}</h3>
              <p>{step.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="grant">
        <h3>{c.grantTitle}</h3>
        <p>{c.grantDesc}</p>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .svc-grid { gap: 1.2rem; }
  .svc-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .svc-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: var(--radius); background: var(--grad-soft); color: var(--c-accent-strong); }
  .svc-eyebrow { font-size: 0.85rem; color: var(--c-faint); font-weight: 600; }
  .svc-lead { color: var(--c-muted); }
  .svc-highlights { display: grid; gap: 0.4rem; margin: 0.4rem 0; }
  .svc-highlights li { display: flex; gap: 0.45rem; align-items: flex-start; color: var(--c-ink); font-size: 0.94rem; }
  .svc-btn { margin-top: auto; align-self: flex-start; }
  .ladder { display: grid; gap: 1rem; max-width: 760px; margin: 0 auto; }
  .ladder-step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); padding: 1.2rem 1.4rem; }
  .ladder-num { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--grad-brand); color: #fff; font-family: var(--font-head); font-weight: 800; }
  .ladder-step h3 { font-size: var(--fs-400); }
  .ladder-step p { color: var(--c-muted); margin-top: 0.3rem; }
  .grant { margin-top: 2.5rem; max-width: 760px; margin-inline: auto; padding: 1.4rem 1.6rem; background: var(--c-surface-warm); border-radius: var(--radius-lg); }
  .grant h3 { margin-bottom: 0.6rem; }
  .grant p { color: var(--c-muted); }
</style>
