---
/**
 * AI 導入傳產線上說明會：場次＋報名表（只有中文版，受眾為台灣傳產；en/ja 路徑導回本頁）。
 * 報名送 console /api/public/contact（建客戶＋聯絡人＋活動紀錄＋待辦，通知 us@twouring.com）；
 * 勾選電子報者另送 console /subscribe（double opt-in，對方確認後才入列）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import WebinarRegister from '../WebinarRegister.astro';
import { localizePath } from '../../i18n/utils';
import { ROUTES } from '../../i18n/ui';
import { company } from '../../i18n/company';
import WebinarSeats from '../WebinarSeats.astro';
import { TOPICS, SESSIONS, upcomingSessions, fmtDate, endsAt, sessionPath, WEBINAR_PATH, OVERVIEW_IMAGE } from '../../data/webinars';

const lp = (p: string) => localizePath(p, 'zh');

const upcoming = upcomingSessions();
const next = upcoming[0];
const topicOrder = ['intro', 'metal', 'machinery', 'labor'] as const;

const title = 'AI 導入傳產線上說明會';
const description =
  '免費線上說明會，週二到週四輪流開場，上午、下午、晚上都有場次：用 60 分鐘看懂傳統產業怎麼導入 AI 與數位轉型——報價、料號、外銷文件、BOM、缺工，現場用模擬資料示範。';

const eventsLd = upcoming.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${title}｜${TOPICS[s.topic].label}：${TOPICS[s.topic].title}`,
  description: TOPICS[s.topic].audience,
  startDate: `${s.date}T${s.start}:00+08:00`,
  endDate: `${s.date}T${s.end}:00+08:00`,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'VirtualLocation', url: company.siteUrl + WEBINAR_PATH },
  isAccessibleForFree: true,
  inLanguage: 'zh-Hant-TW',
  organizer: { '@id': company.siteUrl + '/#organization' },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'TWD', availability: 'https://schema.org/InStock', url: company.siteUrl + WEBINAR_PATH + '#register' },
}));

const agenda = [
  ['10 分', '傳產最常卡住的三個環節（依場次主題）'],
  ['15 分', '現場示範：一律用模擬資料，不碰任何客戶資料'],
  ['10 分', '去識別化案例：五金材料業者料號整合、醫院 24 小時 AI 培訓'],
  ['5 分', '三步做法：現況診斷 → 流程數位化 → AI 導入與內訓'],
  ['20 分', '問答：報名時填的「最卡的流程」，會優先回答'],
];
---
<BaseLayout title={title} description={description} path={WEBINAR_PATH} jsonLd={eventsLd} locales={['zh']}>
  <PageHero
    eyebrow="免費線上說明會｜上午、下午、晚上場輪流開"
    title="傳產導入 AI，先花 60 分鐘看別人怎麼做"
    lead="不賣軟體、不推大系統。用模擬資料現場示範報價、料號、外銷文件、BOM 和新人教材怎麼交給 AI 與系統，聽完知道自己的公司該從哪一步開始。"
    crumbs={[{ label: '線上說明會' }]}
    image={OVERVIEW_IMAGE}
  >
    <div class="cluster hero-cta">
      <a class="btn btn--grad btn--lg" href="#register" data-cta="webinar_hero_register">
        {next ? `報名 ${fmtDate(next.date)} ${TOPICS[next.topic].label}` : '登記下一場通知'}
      </a>
      <a class="btn btn--ghost btn--lg" href="#sessions">看全部場次</a>
    </div>
  </PageHero>

  <section class="section" id="sessions">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">場次</p>
        <h2>四個主題輪流講，<span class="keep">挑跟你產業最近的一場</span></h2>
        <p class="lead">每場 60 分鐘，Google Meet 線上進行，免費參加；每季另加一場專題。報名後會收到 Google 行事曆邀請，裡面附 Meet 連結；開場前一天會再提醒。</p>
      </div>

      {upcoming.length > 0 ? (
        <ol class="sessions" role="list">
          {upcoming.map((s, i) => {
            const tp = TOPICS[s.topic];
            return (
              <li class:list={['card', 'session', { 'session--more': i >= 4 }]} data-ends={endsAt(s)} data-session={s.id}>
                <div class="session-when">
                  <span class="session-date">{fmtDate(s.date, !s.date.startsWith('2026'))}</span>
                  <span class="session-time">{s.start}–{s.end}</span>
                </div>
                <div class="session-body">
                  <span class="tag">{tp.label}</span>
                  <h3><a href={lp(sessionPath(s))}>{tp.title}</a></h3>
                  <p class="session-aud">適合：{tp.audience}</p>
                  <WebinarSeats id={s.id} class="session-seats" />
                </div>
                <div class="session-acts">
                  <a class="btn btn--primary session-btn" href={lp(sessionPath(s))} data-cta="webinar_session_detail">詳細資訊與報名</a>
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="empty">下一輪場次排定中，請在下方留下資料，排定後第一時間通知你。</p>
      )}
      {upcoming.length > 4 && <button type="button" class="btn btn--ghost more-btn" id="more-sessions">看更多場次</button>}
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">主題內容</p>
        <h2>每場講什麼</h2>
      </div>
      <div class="grid grid--2 topics">
        {topicOrder.map((k) => {
          const tp = TOPICS[k];
          return (
            <article class="card topic">
              <img class="topic-img" src={tp.image.src} alt={tp.image.alt} width="1200" height="800" loading="lazy" />
              <span class="tag">{tp.label}</span>
              <h3>{tp.title}</h3>
              <p class="topic-aud">{tp.audience}</p>
              <p class="topic-h">會談到的問題</p>
              <ul role="list">
                {tp.pains.map((p) => (<li><Icon name="check" size={16} /> {p}</li>))}
              </ul>
              <p class="topic-h">現場示範</p>
              <p>{tp.demo}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container agenda-wrap">
      <div>
        <p class="eyebrow">60 分鐘流程</p>
        <h2>每一場都是同一個結構</h2>
        <ol class="agenda" role="list">
          {agenda.map(([m, txt]) => (<li><span class="agenda-m">{m}</span><span>{txt}</span></li>))}
        </ol>
      </div>
      <aside class="card host">
        <img src="/kk-portrait.jpg" alt="主講人徐愷（KK）" width="640" height="965" loading="lazy" />
        <div>
          <p class="topic-h">主講</p>
          <p class="host-name">徐愷（KK）</p>
          <p class="host-role">遊遊股份有限公司負責人／主導顧問</p>
          <p class="host-desc">15 年軟體開發與系統建置經驗，做過五金材料業者的商品資料整合、醫院醫護人員 AI 培訓與政府單位的系統建置。</p>
          <a href={lp(ROUTES.about)}>認識顧問團隊 →</a>
        </div>
      </aside>
    </div>
  </section>

  <WebinarRegister />
</BaseLayout>

<style>
  .hero-cta { margin-top: 1.6rem; }
  .sessions { display: grid; gap: 0.9rem; }
  .session { display: grid; grid-template-columns: 11rem 1fr auto; gap: 1.2rem; align-items: center; padding: 1.2rem 1.4rem; }
  .session-when { display: flex; flex-direction: column; }
  .session-date { white-space: nowrap; font-family: var(--font-head); font-weight: 800; font-size: var(--fs-500); color: var(--c-ink-strong); }
  .sessions:not(.show-all) .session--more { display: none; }
  .more-btn { margin-top: 1rem; }
  .section-head h2, .reg-form h2 { text-wrap: balance; }
  .session-time { color: var(--c-faint); font-size: 0.92rem; }
  .session-body h3 { font-size: var(--fs-500); margin-top: 0.4rem; }
  .session-body h3 a { color: inherit; }
  .session-body h3 a:hover { color: var(--c-accent-strong); }
  .session-body :global(.session-seats) { margin-top: 0.4rem; }
  .session-aud { color: var(--c-muted); font-size: 0.92rem; margin-top: 0.3rem; }
  .empty { color: var(--c-muted); }
  .topics { gap: 1.2rem; }
  .topic-img { width: calc(100% + 2 * var(--card-pad, 1.6rem)); max-width: none; margin: calc(-1 * var(--card-pad, 1.6rem)) calc(-1 * var(--card-pad, 1.6rem)) 0.6rem; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .topic { --card-pad: clamp(1.4rem, 3vw, 2rem); overflow: hidden; display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .topic h3 { font-size: var(--fs-500); }
  .topic-aud { color: var(--c-muted); font-size: 0.92rem; }
  .topic-h { margin-top: 0.6rem; font-family: var(--font-head); font-weight: 700; font-size: 0.82rem; letter-spacing: 0.04em; color: var(--c-faint); }
  .topic ul { display: grid; gap: 0.35rem; }
  .agenda-wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: center; }
  .agenda { margin-top: 1.6rem; display: grid; gap: 0; }
  .agenda li { display: grid; grid-template-columns: 4.6rem 1fr; gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid var(--c-line); font-size: var(--fs-500); }
  .agenda-m { font-family: var(--font-head); font-weight: 800; color: var(--c-accent-strong); }
  .host { display: grid; grid-template-columns: 1fr; gap: 1.1rem; align-items: start; }
  .host img { width: 100%; max-width: 360px; aspect-ratio: 4 / 5; height: auto; object-fit: cover; object-position: center 20%; border-radius: var(--radius-lg); }
  .host-name { font-family: var(--font-head); font-weight: 800; font-size: var(--fs-500); }
  .host-role { color: var(--c-faint); font-size: 0.9rem; }
  .host-desc { color: var(--c-muted); font-size: 0.98rem; line-height: 1.7; margin: 0.6rem 0; }
  .topic li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .topic :global(svg) { color: var(--c-accent-strong); flex-shrink: 0; margin-top: 4px; }
  @media (max-width: 820px) {
    .session { grid-template-columns: 1fr; gap: 0.6rem; }
    .session-btn { justify-self: start; }
    .agenda-wrap { grid-template-columns: 1fr; }
  }
</style>

<script>
  const moreBtn = document.getElementById('more-sessions');
  moreBtn?.addEventListener('click', () => { document.querySelector('.sessions')?.classList.add('show-all'); moreBtn.remove(); });

  // 「報名這場」按鈕：預選該場次
  const sel = document.getElementById('wf-session') as HTMLSelectElement | null;
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => {
    a.addEventListener('click', () => {
      const opt = sel?.querySelector<HTMLOptionElement>(`option[data-id="${a.dataset.pick}"]`);
      if (opt && sel) sel.value = opt.value;
    });
  });
</script>
