---
import InsightArticle from '../../../components/pages/InsightArticle.astro';
import { insightsFor } from '../../../data/insights';
export function getStaticPaths() {
  return insightsFor('en').map((a) => ({ params: { slug: a.slug } }));
}
const { slug } = Astro.params;
---
<InsightArticle slug={slug!} />
